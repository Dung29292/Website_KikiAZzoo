@model Category
@{
    ViewData["Title"] = "Thêm danh mục";
}

<h2 class="fw-bold mb-4">Thêm danh mục</h2>
<form asp-action="Add" method="post">
    <div class="mb-3" style="max-width:450px;">
        <label asp-for="CategoryGroupId" class="form-label">Nhóm danh mục</label>
        <select asp-for="CategoryGroupId" asp-items="ViewBag.CategoryGroups" class="form-select"></select>
    </div>
    <div class="mb-3" style="max-width:450px;">
        <label asp-for="Name" class="form-label">Tên danh mục</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3" style="max-width:450px;">
        <label asp-for="Icon" class="form-label">Icon (Bootstrap Icons)</label>
        <input asp-for="Icon" class="form-control" placeholder="bi-tag" />
    </div>
    <button type="submit" class="btn btn-teal">Thêm</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
