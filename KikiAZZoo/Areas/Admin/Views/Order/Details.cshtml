@model Order
@{
    ViewData["Title"] = $"Đơn hàng #{Model.Id}";
}

<h2 class="fw-bold mb-4">Đơn hàng #@Model.Id</h2>
<div class="row">
    <div class="col-md-6">
        @{
            var user = ViewBag.User as ApplicationUser;
        }
        <p><strong>Khách hàng:</strong> @(user?.FullName ?? "N/A") (@(user?.Email ?? ""))</p>
        <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
        <p><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
        <p><strong>Ghi chú:</strong> @(Model.Notes ?? "Không có")</p>
        
        @if (!string.IsNullOrEmpty(Model.CompanyName))
        {
            <div class="alert alert-info py-2 px-3 mt-2 rounded-3 small">
                <h6 class="fw-bold mb-1"><i class="bi bi-file-earmark-text-fill"></i> Thông tin hóa đơn VAT của khách:</h6>
                <p class="mb-1"><strong>Công ty:</strong> @Model.CompanyName</p>
                <p class="mb-1"><strong>MST:</strong> @Model.TaxCode</p>
                <p class="mb-0"><strong>Địa chỉ:</strong> @Model.CompanyAddress</p>
            </div>
        }
        
        <p><strong>Trạng thái:</strong> <partial name="_OrderStatusBadge" model="Model.Status" /></p>
    </div>
</div>

<h5 class="mt-4">Chi tiết sản phẩm</h5>
<table class="table">
    <thead><tr><th>Sản phẩm</th><th>SL</th><th>Giá</th><th>Tổng</th></tr></thead>
    <tbody>
        @foreach (var d in Model.OrderDetails ?? [])
        {
            <tr>
                <td>@d.Product?.Name</td>
                <td>@d.Quantity</td>
                <td>@d.Price.ToString("#,##0")đ</td>
                <td>@((d.Price * d.Quantity).ToString("#,##0"))đ</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr><th colspan="3">Tổng cộng</th><th>@Model.TotalPrice.ToString("#,##0")đ</th></tr>
    </tfoot>
</table>

<form asp-action="UpdateStatus" method="post" class="d-flex gap-2 align-items-center">
    <input type="hidden" name="id" value="@Model.Id" />
    <select name="status" class="form-select" style="width:auto;">
        <option value="Pending" selected="@(Model.Status == "Pending")">Chờ xác nhận</option>
        <option value="Processing" selected="@(Model.Status == "Processing")">Đang xử lý</option>
        <option value="Shipping" selected="@(Model.Status == "Shipping")">Đang giao hàng</option>
        <option value="Delivered" selected="@(Model.Status == "Delivered")">Đã giao hàng</option>
        <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Đã hủy</option>
    </select>
    <button type="submit" class="btn btn-teal">Cập nhật</button>
</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mt-3 d-flex gap-2">
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    <button type="button" class="btn btn-info text-white" data-bs-toggle="modal" data-bs-target="#vatInvoiceModal">
        <i class="bi bi-file-earmark-pdf"></i> Xuất Hóa Đơn VAT
    </button>
</div>

<!-- Modal Xuất Hóa Đơn VAT -->
<div class="modal fade" id="vatInvoiceModal" tabindex="-1" aria-labelledby="vatInvoiceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="vatInvoiceModalLabel"><i class="bi bi-file-earmark-text"></i> Thông Tin Xuất Hóa Đơn VAT</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="vatInvoiceForm" method="post" asp-action="SendInvoiceEmail">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-body text-start">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên công ty / Đơn vị</label>
                        <input type="text" id="vatCompanyName" name="companyName" class="form-control" placeholder="Công ty TNHH..." value="@Model.CompanyName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mã số thuế (MST)</label>
                        <input type="text" id="vatTaxCode" name="taxCode" class="form-control" placeholder="0102030405" value="@Model.TaxCode" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Địa chỉ công ty</label>
                        <input type="text" id="vatCompanyAddress" name="companyAddress" class="form-control" placeholder="Địa chỉ đăng ký kinh doanh..." value="@Model.CompanyAddress" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email nhận hóa đơn</label>
                        <input type="email" id="vatRecipientEmail" name="recipientEmail" class="form-control" value="@(user?.Email ?? "")" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" onclick="downloadInvoice()" class="btn btn-primary"><i class="bi bi-download"></i> Tải hóa đơn</button>
                    <button type="submit" class="btn btn-success"><i class="bi bi-envelope"></i> Gửi qua Email</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function downloadInvoice() {
        const id = @Model.Id;
        const companyName = encodeURIComponent(document.getElementById('vatCompanyName').value);
        const taxCode = encodeURIComponent(document.getElementById('vatTaxCode').value);
        const companyAddress = encodeURIComponent(document.getElementById('vatCompanyAddress').value);
        
        const url = `@Url.Action("ExportInvoice")?id=${id}&companyName=${companyName}&taxCode=${taxCode}&companyAddress=${companyAddress}`;
        window.open(url, '_blank');
    }
</script>
