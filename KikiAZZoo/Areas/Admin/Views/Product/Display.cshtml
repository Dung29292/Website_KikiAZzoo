@model Product
@{
    ViewData["Title"] = Model.Name;
}

<h2>@Model.Name</h2>
<p><strong>Giá:</strong> @Model.Price.ToString("#,##0")đ</p>
<p><strong>Danh mục:</strong> @Model.Category?.Name</p>
<p><strong>Mô tả:</strong> @Html.Raw(Model.Description)</p>
@if (!string.IsNullOrEmpty(Model.ImageUrl))
{
    <img src="@Model.ImageUrl" style="max-width:300px;border-radius:12px;" />
}
<br />
<a asp-action="Index" class="btn btn-secondary mt-3">Quay lại</a>
