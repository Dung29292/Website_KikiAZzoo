@model Product
@{
    ViewData["Title"] = "Xác nhận xóa sản phẩm";
    bool hasOrders = ViewBag.HasOrders == true;
    ViewData["Breadcrumbs"] = new List<(string Name, string Url)>
    {
        ("Sản phẩm", "/Admin/Product"),
        ("Xóa sản phẩm", "")
    };
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-danger text-white py-3 px-4 d-flex align-items-center gap-2">
                <i class="bi bi-trash3-fill fs-5"></i>
                <h5 class="mb-0 fw-bold">Xác nhận thao tác xóa</h5>
            </div>
            <div class="card-body p-4">
                @if (hasOrders)
                {
                    <div class="alert alert-warning border-0 rounded-3 mb-4 d-flex align-items-start gap-3">
                        <i class="bi bi-exclamation-triangle-fill fs-4 text-warning flex-shrink-0 mt-1"></i>
                        <div>
                            <div class="fw-bold mb-1">Sản phẩm đã phát sinh trong đơn hàng của khách!</div>
                            <div class="small text-muted">
                                Sản phẩm <strong>@Model.Name</strong> đã có dữ liệu trong các đơn hàng đã đặt. 
                                Để tuân thủ toàn vẹn dữ liệu kế toán và lịch sử hóa đơn, khi bạn xác nhận xóa, hệ thống sẽ <strong>chuyển sang trạng thái [Đang ẩn / Ngừng kinh doanh]</strong> thay vì xóa vĩnh viễn khỏi cơ sở dữ liệu.
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger-soft text-danger border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <span>Thao tác xóa vĩnh viễn sẽ xóa hoàn toàn thông tin sản phẩm và không thể hoàn tác.</span>
                    </div>
                }

                <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 mb-4">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/product-placeholder.png" : Model.ImageUrl)" 
                         alt="@Model.Name" 
                         class="rounded-3 object-fit-cover shadow-sm border" 
                         style="width: 72px; height: 72px;" />
                    <div class="flex-grow-1">
                        <h6 class="fw-bold mb-1 text-dark">@Model.Name</h6>
                        <div class="small text-muted d-flex gap-3">
                            <span><i class="bi bi-tag me-1"></i>Giá: <strong>@Model.Price.ToString("N0") đ</strong></span>
                            <span><i class="bi bi-box-seam me-1"></i>Kho: <strong>@Model.Stock</strong></span>
                        </div>
                        <div class="small text-muted mt-1">
                            <span>Danh mục: @(Model.Category?.Name ?? "Không phân loại")</span>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-secondary px-4 rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn @(hasOrders ? "btn-warning text-dark" : "btn-danger") px-4 rounded-pill fw-semibold">
                        @(hasOrders ? "Ngừng bán & Ẩn sản phẩm" : "Xác nhận xóa vĩnh viễn")
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

