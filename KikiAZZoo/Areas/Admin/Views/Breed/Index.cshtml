@model IEnumerable<KikiAZZoo.Models.Breed>
@{
    ViewData["Title"] = "Quản lý Giống loài Thú cưng";
    ViewData["Breadcrumbs"] = new List<(string Name, string Url)>
    {
        ("Thú cưng & Cá cảnh", "/Admin/Pet"),
        ("Giống loài", "")
    };
    var petTypes = ViewBag.PetTypes as List<KikiAZZoo.Models.PetType> ?? new();
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<!-- Filter Bar -->
<div class="card shadow-sm border-0 mb-4 bg-light-soft" style="background-color: #f8fafc; border: 1px solid #e2e8f0 !important;">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-5">
                <label class="form-label small text-muted fw-bold">Tìm kiếm giống loài</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Tên giống loài, nguồn gốc..." />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted fw-bold">Phân loại theo loài</label>
                <select name="petTypeId" class="form-select form-select-sm">
                    <option value="">Tất cả các loài</option>
                    @foreach (var pt in petTypes)
                    {
                        <!option value="@pt.Id" @(ViewBag.SelectedPetTypeId == pt.Id ? "selected" : "")>@pt.Name</!option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-counterclockwise"></i> Đặt lại
                </a>
                <button type="submit" class="btn btn-teal btn-sm rounded-pill px-4 text-white">
                    <i class="bi bi-funnel"></i> Lọc
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Header Action Row -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="small text-muted">
        Tổng số: <strong>@ViewBag.TotalCount</strong> giống loài thú cưng
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Pet" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Danh sách Thú cưng
        </a>
        @if (User.IsInRole(SD.Role_Admin))
        {
            <a asp-action="Upsert" class="btn btn-teal rounded-pill px-4 shadow-sm text-white btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Thêm Giống Loài Mới
            </a>
        }
    </div>
</div>

<!-- Table -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;" class="text-center">#</th>
                    <th>Tên giống loài</th>
                    <th style="width: 140px;">Mã giống (SKU)</th>
                    <th>Thuộc loài</th>
                    <th>Nguồn gốc / Xuất xứ</th>
                    <th>Mô tả đặc điểm</th>
                    <th class="text-center" style="width: 120px;">Số bé hiện có</th>
                    <th class="text-end" style="width: 130px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    int index = (currentPage - 1) * 12 + 1;
                    foreach (var item in Model)
                    {
                        int petCount = item.Pets?.Count ?? 0;
                        <tr>
                            <td class="text-center text-muted fw-bold">@(index++)</td>
                            <td>
                                <strong class="text-teal fs-6">@item.Name</strong>
                            </td>
                            <td>
                                <span class="badge bg-light text-teal border border-teal-subtle fw-bold px-2 py-1 font-monospace">
                                    <i class="bi bi-tag-fill me-1 text-teal"></i>@(string.IsNullOrEmpty(item.Code) ? "—" : item.Code)
                                </span>
                            </td>
                            <td>
                                @if (item.PetType != null)
                                {
                                    <span class="badge bg-teal-subtle text-teal border border-teal rounded-pill px-3 py-1">
                                        <i class="bi @item.PetType.Icon me-1"></i> @item.PetType.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Chưa xác định</span>
                                }
                            </td>
                            <td>
                                <span class="text-muted"><i class="bi bi-geo-alt me-1 text-danger"></i> @(string.IsNullOrEmpty(item.Origin) ? "Đang cập nhật" : item.Origin)</span>
                            </td>
                            <td>
                                <span class="text-muted small text-truncate d-inline-block" style="max-width: 280px;" title="@item.Description">
                                    @(string.IsNullOrEmpty(item.Description) ? "—" : item.Description)
                                </span>
                            </td>
                            <td class="text-center">
                                <a asp-controller="Pet" asp-action="Index" asp-route-breedId="@item.Id" class="badge @(petCount > 0 ? "bg-success-subtle text-success border border-success" : "bg-light text-muted border") rounded-pill px-3 py-1 text-decoration-none">
                                    <i class="bi bi-heart me-1"></i> @petCount bé
                                </a>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (User.IsInRole(SD.Role_Admin))
                                    {
                                        <a asp-action="Upsert" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Chỉnh sửa thông tin giống loài">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" title="Xóa giống loài" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                        <!-- Delete Modal -->
                                        <div class="modal fade text-start" id="deleteModal-@item.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-4 border-0 shadow">
                                                    <div class="modal-header border-0 pb-0">
                                                        <h5 class="modal-title fw-bold text-danger">
                                                            <i class="bi bi-exclamation-triangle me-2"></i> Xác nhận xóa
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body py-3">
                                                        <p class="mb-1">Bạn có chắc chắn muốn xóa giống loài <strong>@item.Name</strong> không?</p>
                                                        @if (petCount > 0)
                                                        {
                                                            <div class="alert alert-warning small rounded-3 mt-2 mb-0">
                                                                <i class="bi bi-info-circle me-1"></i> Đang có <strong>@petCount</strong> bé thú cưng thuộc giống này. Bạn cần chuyển hoặc xóa các bé thú cưng này trước khi xóa giống loài.
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <small class="text-muted">Hành động này không thể hoàn tác.</small>
                                                        }
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger rounded-pill px-4" @(petCount > 0 ? "disabled" : "")>
                                                                <i class="bi bi-trash me-1"></i> Xóa
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">Chỉ xem</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            Không tìm thấy giống loài nào phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
            <span class="small text-muted">Trang @currentPage / @totalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link rounded-pill me-1" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@ViewBag.Search" asp-route-petTypeId="@ViewBag.SelectedPetTypeId">&laquo;</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link rounded-pill mx-1" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-petTypeId="@ViewBag.SelectedPetTypeId">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link rounded-pill ms-1" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@ViewBag.Search" asp-route-petTypeId="@ViewBag.SelectedPetTypeId">&raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>
