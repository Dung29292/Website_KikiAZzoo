@model Coupon
@{
    bool isCreate = Model.Id == 0;
    ViewData["Title"] = isCreate ? "Tạo mã giảm giá mới" : "Sửa mã giảm giá";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary rounded-circle" style="width:36px;height:36px;padding:0;display:flex;align-items:center;justify-content:center;">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h2 class="fw-bold mb-0">
            <i class="bi bi-tag-fill text-warning"></i>
            @(isCreate ? "Tạo mã giảm giá mới" : $"Sửa mã: {Model.Code}")
        </h2>
        <p class="text-muted small mb-0">@(isCreate ? "Điền thông tin để tạo coupon mới" : "Cập nhật thông tin mã giảm giá")</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <form asp-action="Upsert" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="UsageCount" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3 rounded-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Code" class="form-label fw-semibold">
                                <i class="bi bi-upc-scan text-warning me-1"></i>Mã Code <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Code" class="form-control font-monospace text-uppercase fw-bold"
                                   placeholder="VD: KIKI10, NEWUSER..." style="letter-spacing:2px;" required />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                            <small class="text-muted">Mã sẽ tự động được chuyển thành CHỮ HOA</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold"><i class="bi bi-sliders text-primary me-1"></i>Kiểu giảm giá <span class="text-danger">*</span></label>
                            <div class="d-flex gap-3 mt-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="IsPercentage" value="true" id="typePercent" />
                                    <label class="form-check-label" for="typePercent">
                                        <i class="bi bi-percent text-success"></i> Phần trăm (%)
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="IsPercentage" value="false" id="typeFixed" />
                                    <label class="form-check-label" for="typeFixed">
                                        <i class="bi bi-currency-exchange text-info"></i> Số tiền cố định (đ)
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DiscountValue" class="form-label fw-semibold">
                                <i class="bi bi-gift text-danger me-1"></i>Giá trị giảm <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="DiscountValue" asp-format="{0:0}" type="number" class="form-control" min="0" step="any" placeholder="10" required />
                                <span class="input-group-text fw-bold" id="discountSuffix">%</span>
                            </div>
                            <span asp-validation-for="DiscountValue" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MinOrderValue" class="form-label fw-semibold">
                                <i class="bi bi-cart-check text-primary me-1"></i>Đơn hàng tối thiểu (đ)
                            </label>
                            <input asp-for="MinOrderValue" asp-format="{0:0}" type="number" class="form-control" min="0" step="any" placeholder="100000" />
                            <span asp-validation-for="MinOrderValue" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label fw-semibold">
                                <i class="bi bi-calendar-event me-1"></i>Ngày bắt đầu <span class="text-danger">*</span>
                            </label>
                            <input asp-for="StartDate" type="date" class="form-control" required />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label fw-semibold">
                                <i class="bi bi-calendar-x me-1"></i>Ngày kết thúc <span class="text-danger">*</span>
                            </label>
                            <input asp-for="EndDate" type="date" class="form-control" required />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MaxUsage" class="form-label fw-semibold">
                                <i class="bi bi-people me-1"></i>Số lần sử dụng tối đa
                            </label>
                            <input asp-for="MaxUsage" type="number" class="form-control" min="1" placeholder="Để trống = không giới hạn" />
                            <span asp-validation-for="MaxUsage" class="text-danger small"></span>
                            <small class="text-muted">Để trống nếu không giới hạn số lần dùng</small>
                        </div>

                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActiveSwitch" role="switch" />
                                <label class="form-check-label fw-semibold" for="isActiveSwitch">
                                    <i class="bi bi-power text-success me-1"></i>Kích hoạt ngay
                                </label>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-warning rounded-pill px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> @(isCreate ? "Tạo mã giảm giá" : "Lưu thay đổi")
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-x-lg me-1"></i> Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 bg-warning bg-opacity-10">
            <div class="card-body p-4">
                <h6 class="fw-bold text-warning mb-3"><i class="bi bi-info-circle"></i> Hướng dẫn tạo mã</h6>
                <ul class="small text-muted ps-3 mb-0">
                    <li class="mb-2"><strong>Mã Code</strong>: Tối đa 20 ký tự, tự động hoa. Ví dụ: <code>KIKI10</code>, <code>SUMMER2025</code></li>
                    <li class="mb-2"><strong>Giảm %</strong>: Nhập số % muốn giảm (VD: 10 = giảm 10%)</li>
                    <li class="mb-2"><strong>Giảm tiền</strong>: Nhập số tiền cố định (VD: 50000 = giảm 50.000đ)</li>
                    <li class="mb-2"><strong>Đơn tối thiểu</strong>: Khách phải mua ít nhất bao nhiêu mới được dùng mã</li>
                    <li class="mb-2"><strong>Số lần dùng</strong>: Giới hạn tổng số lượt dùng toàn hệ thống</li>
                </ul>
                <div class="mt-3 p-2 bg-white rounded-3 border small">
                    <strong class="text-warning"><i class="bi bi-ticket-perforated"></i> Mã test có sẵn:</strong>
                    <br />
                    <code class="me-2">KIKI10</code> - Giảm 10%, đơn từ 100k<br />
                    <code>SPALOVE</code> - Giảm 50k, đơn từ 200k
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Update suffix label based on discount type selection
        document.querySelectorAll('input[name="IsPercentage"]').forEach(radio => {
            radio.addEventListener('change', function () {
                const suffix = document.getElementById('discountSuffix');
                suffix.textContent = this.value === 'true' ? '%' : 'đ';
            });
        });
    </script>
}
