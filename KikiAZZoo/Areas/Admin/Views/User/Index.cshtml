@model IEnumerable<KikiAZZoo.Models.ViewModels.UserItemViewModel>
@{
    ViewData["Title"] = "Quản lý Tài khoản & Phân quyền";
    ViewData["Breadcrumbs"] = new List<(string Name, string Url)>
    {
        ("Tài khoản", "")
    };
    var currentEmail = User.Identity?.Name ?? "";
}



<!-- Filters & Actions Header -->
<div class="card shadow-sm border-0 mb-4 bg-light-soft" style="background-color: #f8fafc; border: 1px solid #e2e8f0 !important;">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-5">
                <label class="form-label small text-muted fw-bold">Tìm kiếm tài khoản</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Tên, Email hoặc Số điện thoại..." />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted fw-bold">Vai trò (Role)</label>
                <select name="role" class="form-select form-select-sm">
                    <!option value="" @(string.IsNullOrEmpty(ViewBag.SelectedRole) ? "selected" : "")>Tất cả vai trò</!option>
                    <!option value="Admin" @(ViewBag.SelectedRole == "Admin" ? "selected" : "")>Quản trị viên (Admin)</!option>
                    <!option value="Employee" @(ViewBag.SelectedRole == "Employee" ? "selected" : "")>Nhân viên (Employee)</!option>
                    <!option value="Customer" @(ViewBag.SelectedRole == "Customer" ? "selected" : "")>Khách hàng (Customer)</!option>
                    <!option value="Company" @(ViewBag.SelectedRole == "Company" ? "selected" : "")>Doanh nghiệp (Company)</!option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-teal btn-sm w-100 fw-bold"><i class="bi bi-filter"></i> Lọc tài khoản</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0 text-teal"><i class="bi bi-people-fill me-2"></i>Danh sách người dùng &amp; nhân viên</h5>
            <small class="text-muted">Tổng cộng: <strong>@Model.Count()</strong> tài khoản</small>
        </div>
        <a asp-action="Create" class="btn btn-teal btn-sm fw-bold">
            <i class="bi bi-person-plus-fill me-1"></i> Tạo tài khoản mới
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Họ tên &amp; Email</th>
                    <th>Số điện thoại</th>
                    <th>Vai trò hiện tại</th>
                    <th>Đổi vai trò</th>
                    <th>Trạng thái</th>
                    <th>Đơn hàng</th>
                    <th class="text-end" style="width: 140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Không tìm thấy tài khoản nào.</td>
                    </tr>
                }
                else
                {
                    foreach (var u in Model)
                    {
                        var isCurrentAdmin = u.Email.Equals(currentEmail, StringComparison.OrdinalIgnoreCase);
                        <tr class="@(u.IsLockedOut ? "table-danger opacity-75" : "")">
                            <td>
                                <div class="fw-bold text-dark">
                                    @u.FullName
                                    @if (isCurrentAdmin)
                                    {
                                        <span class="badge bg-primary-soft text-primary small ms-1" style="font-size: 0.65rem;">(Bạn)</span>
                                    }
                                </div>
                                <div class="text-muted small" style="font-size: 0.8rem;"><i class="bi bi-envelope me-1"></i>@u.Email</div>
                            </td>
                            <td>
                                <span class="small font-monospace">@(string.IsNullOrEmpty(u.PhoneNumber) ? "Chưa cập nhật" : u.PhoneNumber)</span>
                            </td>
                            <td>
                                @if (u.Role == SD.Role_Admin)
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-1"><i class="bi bi-shield-lock-fill me-1"></i>Admin</span>
                                }
                                else if (u.Role == SD.Role_Employee)
                                {
                                    <span class="badge bg-teal rounded-pill px-3 py-1 text-white"><i class="bi bi-briefcase-fill me-1"></i>Nhân viên</span>
                                }
                                else if (u.Role == SD.Role_Company)
                                {
                                    <span class="badge bg-info rounded-pill px-3 py-1 text-white"><i class="bi bi-building me-1"></i>Doanh nghiệp</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill px-3 py-1"><i class="bi bi-person-fill me-1"></i>Khách hàng</span>
                                }
                            </td>
                            <td>
                                @if (isCurrentAdmin)
                                {
                                    <span class="text-muted small fst-italic">Quản trị viên chính</span>
                                }
                                else
                                {
                                    <form asp-action="ChangeRole" method="post" class="d-inline-flex align-items-center gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <select name="newRole" class="form-select form-select-sm" style="width: 130px; font-size: 0.8rem;" onchange="this.form.submit()">
                                            <!option value="Customer" @(u.Role == SD.Role_Customer ? "selected" : "")>Khách hàng</!option>
                                            <!option value="Employee" @(u.Role == SD.Role_Employee ? "selected" : "")>Nhân viên</!option>
                                            <!option value="Admin" @(u.Role == SD.Role_Admin ? "selected" : "")>Admin</!option>
                                            <!option value="Company" @(u.Role == SD.Role_Company ? "selected" : "")>Doanh nghiệp</!option>
                                        </select>
                                    </form>
                                }
                            </td>
                            <td>
                                @if (u.IsLockedOut)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Đã bị khóa</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-soft text-success"><i class="bi bi-check-circle-fill me-1"></i>Hoạt động</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@u.OrdersCount đơn</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (!isCurrentAdmin)
                                    {
                                        <form asp-action="ToggleLock" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn @(u.IsLockedOut ? "mở khóa" : "khóa") tài khoản @u.Email?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            @if (u.IsLockedOut)
                                            {
                                                <button type="submit" class="btn btn-outline-success p-1 px-2" title="Mở khóa tài khoản">
                                                    <i class="bi bi-unlock-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-danger p-1 px-2" title="Khóa tài khoản này">
                                                    <i class="bi bi-lock-fill"></i>
                                                </button>
                                            }
                                        </form>
                                    }
                                    <button type="button" class="btn btn-outline-secondary p-1 px-2" title="Đặt lại mật khẩu" data-bs-toggle="modal" data-bs-target="#resetPwdModal@(u.Id)">
                                        <i class="bi bi-key-fill"></i>
                                    </button>
                                </div>

                                <!-- Modal Reset Password -->
                                <div class="modal fade" id="resetPwdModal@(u.Id)" tabindex="-1" aria-hidden="true" style="text-align: left;">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow">
                                            <form asp-action="ResetPassword" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@u.Id" />
                                                <div class="modal-header">
                                                    <h6 class="modal-title fw-bold"><i class="bi bi-key me-2 text-teal"></i>Đặt lại mật khẩu cho @u.FullName</h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="small text-muted mb-3">Tài khoản: <strong>@u.Email</strong></p>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-bold">Mật khẩu mới (Tối thiểu 6 ký tự)</label>
                                                        <input type="password" name="newPassword" class="form-control" required minlength="6" placeholder="Nhập mật khẩu mới..." />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                    <button type="submit" class="btn btn-sm btn-teal fw-bold">Lưu mật khẩu mới</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
