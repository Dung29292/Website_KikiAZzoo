@{
    ViewData["Title"] = "Yêu cầu đã gửi";
    Layout = "_Layout";
}

<section class="auth-page auth-page-login">
    <div class="container">
        <div class="auth-hero-card auth-animate-in">
            <div class="row g-0 align-items-stretch">
                <div class="col-lg-6 auth-visual auth-visual-login">
                    <div class="auth-visual-content">
                        <img src="~/images/auth-login.svg" alt="KikiAzoo Pets" class="auth-hero-img auth-float" />
                        <div class="auth-visual-badge auth-fade-delay-1">
                            <i class="bi bi-check-circle-fill"></i> Đã gửi yêu cầu
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 auth-form-side">
                    <div class="auth-form-wrap text-center">
                        <div class="auth-form-header auth-slide-up">
                            <span class="auth-icon-circle auth-icon-teal"><i class="bi bi-envelope-check"></i></span>
                            <h2>Yêu cầu đã được gửi</h2>
                            <p>Kiểm tra hộp thư đến của bạn để nhận hướng dẫn đặt lại mật khẩu.</p>
                        </div>
                        <a asp-action="Login" class="btn btn-auth-primary mt-4">Quay lại Đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
