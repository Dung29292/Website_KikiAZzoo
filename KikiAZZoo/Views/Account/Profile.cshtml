@model ProfileViewModel
@{
    ViewData["Title"] = "Tài khoản của tôi";
}

<style>
    .profile-container {
        animation: fadeIn 0.4s ease-in-out;
    }

    .premium-membership-card {
        background: linear-gradient(135deg, var(--teal-dark) 0%, var(--teal) 100%);
        color: #ffffff;
        border-radius: 16px;
        padding: 1.5rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(13, 148, 136, 0.25);
    }

    .premium-membership-card::after {
        content: '';
        position: absolute;
        width: 150px;
        height: 150px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 50%;
        top: -50px;
        right: -50px;
    }

    .premium-card-icon {
        position: absolute;
        bottom: 15px;
        right: 15px;
        font-size: 3.5rem;
        opacity: 0.15;
    }

    .profile-form-control {
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        padding: 0.65rem 1rem;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .profile-form-control:focus {
        border-color: var(--teal);
        box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.15);
        outline: none;
    }

    body.dark-mode .profile-form-control {
        background-color: #0f172a;
        border-color: #334155;
        color: #f1f5f9;
    }

    body.dark-mode .profile-form-control:focus {
        border-color: var(--teal);
    }
</style>

<div class="container py-4 profile-page profile-container">
    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3">
            <div class="profile-nav-card p-3 rounded-4 shadow-sm border bg-white">
                <div class="text-center py-3">
                    <div class="avatar-placeholder bg-teal-light text-teal rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; font-size: 2.2rem;">
                        <i class="ph-fill ph-user"></i>
                    </div>
                    <h5 class="fw-bold mb-3">@Model.FullName</h5>
                    
                    <!-- Membership Loyalty Card -->
                    <div class="premium-membership-card text-start">
                        <i class="ph ph-crown premium-card-icon"></i>
                        <span class="small text-uppercase opacity-75 d-block mb-1" style="font-size: 0.75rem; letter-spacing: 1px;">Thành viên KikiAzoo</span>
                        <div class="d-flex align-items-baseline gap-2">
                            <span class="fs-3 fw-extrabold">@Model.LoyaltyPoints.ToString("#,##0")</span>
                            <span class="small opacity-90">Kiki-Xu</span>
                        </div>
                        <div class="mt-3 pt-2 border-top border-white-10" style="border-top: 1px solid rgba(255, 255, 255, 0.15);">
                            <span class="small opacity-75" style="font-size: 0.75rem;"><i class="ph ph-sparkle"></i> Tích lũy mua sắm</span>
                        </div>
                    </div>
                </div>
                <hr class="my-3" />
                <div class="list-group list-group-flush border-0">
                    <a asp-controller="Account" asp-action="Profile" class="list-group-item list-group-item-action border-0 px-2 py-2 rounded-3 active"><i class="ph ph-user-circle-gear me-2"></i> Thông tin tài khoản</a>
                    <a asp-controller="Account" asp-action="Orders" class="list-group-item list-group-item-action border-0 px-2 py-2 rounded-3"><i class="ph ph-receipt me-2"></i> Đơn hàng đã mua</a>
                    <a asp-controller="Pet" asp-action="Index" class="list-group-item list-group-item-action border-0 px-2 py-2 rounded-3"><i class="ph ph-paw-print me-2"></i> Hồ sơ thú cưng</a>
                    <a asp-controller="ServiceBooking" asp-action="Index" class="list-group-item list-group-item-action border-0 px-2 py-2 rounded-3"><i class="ph ph-calendar-check me-2"></i> Lịch hẹn dịch vụ</a>
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-lg-9">
            <div class="checkout-card p-4 rounded-4 shadow-sm border bg-white">
                <h3 class="fw-bold mb-4 text-dark"><i class="ph ph-user-circle text-teal me-2"></i> Thông tin tài khoản</h3>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                        <i class="ph ph-check-circle-fill"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="padding: 0.8rem 1rem;"></button>
                    </div>
                }

                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold text-muted">Họ và tên</label>
                            <input asp-for="FullName" class="form-control profile-form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted">Email đăng nhập</label>
                            <input value="@Model.Email" class="form-control profile-form-control" disabled style="background-color: rgba(241, 245, 249, 0.6);" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold text-muted">Số điện thoại</label>
                            <input asp-for="PhoneNumber" class="form-control profile-form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Age" class="form-label fw-semibold text-muted">Tuổi</label>
                            <input asp-for="Age" class="form-control profile-form-control" />
                            <span asp-validation-for="Age" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold text-muted">Địa chỉ giao hàng</label>
                            <textarea asp-for="Address" class="form-control profile-form-control" rows="3" placeholder="Số nhà, ngõ, tên đường, phường/xã, quận/huyện, tỉnh/thành..."></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-teal rounded-pill px-4 mt-4 shadow-sm">
                        <i class="ph ph-floppy-disk"></i> Lưu thay đổi
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

