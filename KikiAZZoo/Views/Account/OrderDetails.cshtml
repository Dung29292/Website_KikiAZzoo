@model Order
@{
    ViewData["Title"] = $"Đơn hàng #{Model.Id}";
}

<div class="container py-5">
    <nav class="breadcrumb-kiki mb-3">
        <a asp-action="Orders">Đơn hàng của tôi</a> &gt; #@Model.Id
    </nav>

    <div class="checkout-card">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
            <div>
                <h3 class="fw-bold mb-1">Đơn hàng #@Model.Id</h3>
                <p class="text-muted mb-0">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <partial name="_OrderStatusBadge" model="Model.Status" />
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="order-info-box">
                    <h6><i class="bi bi-geo-alt"></i> Địa chỉ giao hàng</h6>
                    <p>@Model.ShippingAddress</p>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="col-md-6">
                    <div class="order-info-box">
                        <h6><i class="bi bi-chat-left-text"></i> Ghi chú</h6>
                        <p>@Model.Notes</p>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.CompanyName))
            {
                <div class="col-12">
                    <div class="order-info-box alert alert-info py-3 px-4 rounded-3" style="border: 1px solid rgba(13, 148, 136, 0.15) !important; background: rgba(13, 148, 136, 0.03);">
                        <h6 class="fw-bold mb-2 text-teal"><i class="bi bi-file-earmark-text-fill"></i> Yêu cầu hóa đơn VAT:</h6>
                        <p class="mb-1 text-dark"><strong>Công ty:</strong> @Model.CompanyName</p>
                        <p class="mb-1 text-dark"><strong>MST:</strong> @Model.TaxCode</p>
                        <p class="mb-0 text-dark"><strong>Địa chỉ:</strong> @Model.CompanyAddress</p>
                    </div>
                </div>
            }
        </div>

        <h5 class="fw-bold mb-3">Sản phẩm</h5>
        <div class="d-none d-md-block">
            <table class="table cart-table">
                <thead><tr><th>Sản phẩm</th><th>SL</th><th>Giá</th><th>Tổng</th></tr></thead>
                <tbody>
                    @foreach (var d in Model.OrderDetails ?? [])
                    {
                        <tr>
                            <td>@d.Product?.Name</td>
                            <td>@d.Quantity</td>
                            <td>@d.Price.ToString("#,##0")đ</td>
                            <td class="fw-bold">@((d.Price * d.Quantity).ToString("#,##0"))đ</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><th colspan="3">Tổng cộng</th><th class="product-price">@Model.TotalPrice.ToString("#,##0")đ</th></tr>
                </tfoot>
            </table>
        </div>

        <div class="d-md-none">
            @foreach (var d in Model.OrderDetails ?? [])
            {
                <div class="cart-mobile-item">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="fw-bold">@d.Product?.Name</span>
                        <span class="text-teal">@((d.Price * d.Quantity).ToString("#,##0"))đ</span>
                    </div>
                    <span class="text-muted small">@d.Quantity x @d.Price.ToString("#,##0")đ</span>
                </div>
            }
            <div class="d-flex justify-content-between fw-bold fs-5 mt-3 pt-3 border-top">
                <span>Tổng cộng</span>
                <span class="product-price">@Model.TotalPrice.ToString("#,##0")đ</span>
            </div>
        </div>

        @inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
        @{
            var currentUser = await UserManager.GetUserAsync(User);
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="d-flex gap-2 mt-4 flex-wrap">
            <a asp-action="Orders" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
            <button type="button" class="btn btn-info text-white" data-bs-toggle="modal" data-bs-target="#vatInvoiceModal">
                <i class="bi bi-file-earmark-pdf"></i> Xuất Hóa Đơn VAT
            </button>
        </div>
    </div>
</div>

<!-- Modal Xuất Hóa Đơn VAT -->
<div class="modal fade" id="vatInvoiceModal" tabindex="-1" aria-labelledby="vatInvoiceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="vatInvoiceModalLabel" style="color: #333;"><i class="bi bi-file-earmark-text"></i> Thông Tin Xuất Hóa Đơn VAT</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="vatInvoiceForm" method="post" asp-action="SendInvoiceEmail">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-body text-start" style="color: #333;">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên công ty / Đơn vị</label>
                        <input type="text" id="vatCompanyName" name="companyName" class="form-control" placeholder="Công ty TNHH..." value="@Model.CompanyName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mã số thuế (MST)</label>
                        <input type="text" id="vatTaxCode" name="taxCode" class="form-control" placeholder="0102030405" value="@Model.TaxCode" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Địa chỉ công ty</label>
                        <input type="text" id="vatCompanyAddress" name="companyAddress" class="form-control" placeholder="Địa chỉ đăng ký kinh doanh..." value="@Model.CompanyAddress" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email nhận hóa đơn</label>
                        <input type="email" id="vatRecipientEmail" name="recipientEmail" class="form-control" value="@(currentUser?.Email ?? "")" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" onclick="downloadInvoice()" class="btn btn-primary"><i class="bi bi-download"></i> Tải hóa đơn</button>
                    <button type="submit" class="btn btn-success"><i class="bi bi-envelope"></i> Gửi qua Email</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function downloadInvoice() {
        const id = @Model.Id;
        const companyName = encodeURIComponent(document.getElementById('vatCompanyName').value);
        const taxCode = encodeURIComponent(document.getElementById('vatTaxCode').value);
        const companyAddress = encodeURIComponent(document.getElementById('vatCompanyAddress').value);
        
        const url = `@Url.Action("ExportInvoice")?id=${id}&companyName=${companyName}&taxCode=${taxCode}&companyAddress=${companyAddress}`;
        window.open(url, '_blank');
    }
</script>
