@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = "_Layout";
}

<section class="auth-page auth-page-register">
    <div class="container">
        <div class="auth-hero-card auth-animate-in">
            <div class="row g-0 align-items-stretch flex-lg-row-reverse">
                <div class="col-lg-6 auth-visual auth-visual-register">
                    <div class="auth-visual-content">
                        <img src="/images/dangki.jpg" alt="Tham gia KikiAzoo" class="auth-hero-img auth-float" />
                        <div class="auth-visual-badge auth-visual-badge-orange auth-fade-delay-1">
                            <i class="bi bi-gift-fill"></i> Ưu đãi thành viên mới
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 auth-form-side">
                    <div class="auth-form-wrap">
                        <div class="auth-form-header auth-slide-up">
                            <span class="auth-icon-circle auth-icon-orange"><i class="bi bi-person-plus"></i></span>
                            <h2>Tạo tài khoản</h2>
                            <p>Đăng ký để mua sắm và nhận ưu đãi độc quyền</p>
                        </div>

                        <form asp-action="Register" method="post" class="auth-slide-up auth-fade-delay-1">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                            <div class="mb-3">
                                <label asp-for="FullName" class="form-label">Họ và tên</label>
                                <div class="input-group auth-input-group auth-input-orange">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6 mb-0">
                                    <label asp-for="Email" class="form-label">Email</label>
                                    <div class="input-group auth-input-group auth-input-orange">
                                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                        <input asp-for="Email" class="form-control" placeholder="email@example.com" />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-0">
                                    <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                                    <div class="input-group auth-input-group auth-input-orange">
                                        <span class="input-group-text"><i class="bi bi-phone"></i></span>
                                        <input asp-for="PhoneNumber" class="form-control" placeholder="0901234567" />
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3 mt-0">
                                <div class="col-md-6">
                                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                                    <div class="input-group auth-input-group auth-input-orange">
                                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                        <input asp-for="Password" class="form-control" id="regPassword" placeholder="Tối thiểu 6 ký tự" />
                                        <button type="button" class="input-group-text btn-toggle-password" onclick="togglePassword('regPassword', this)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ConfirmPassword" class="form-label">Xác nhận MK</label>
                                    <div class="input-group auth-input-group auth-input-orange">
                                        <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                                        <input asp-for="ConfirmPassword" class="form-control" id="regConfirmPassword" />
                                        <button type="button" class="input-group-text btn-toggle-password" onclick="togglePassword('regConfirmPassword', this)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-auth-secondary w-100 mt-4">
                                <span>ĐĂNG KÝ</span>
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        </form>

                        <p class="auth-switch-text auth-fade-delay-2">
                            Đã có tài khoản?
                            <a asp-action="Login" class="auth-link-teal fw-semibold">Đăng nhập</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
