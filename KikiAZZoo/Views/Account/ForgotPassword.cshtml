@model KikiAZZoo.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_Layout";
}

<section class="auth-page auth-page-login">
    <div class="container">
        <div class="auth-hero-card auth-animate-in">
            <div class="row g-0 align-items-stretch">
                <div class="col-lg-6 auth-visual auth-visual-login">
                    <div class="auth-visual-content">
                        <img src="~/images/auth-login.svg" alt="KikiAzoo Pets" class="auth-hero-img auth-float" />
                        <div class="auth-visual-badge auth-fade-delay-1">
                            <i class="bi bi-shield-lock"></i> Hỗ trợ khôi phục mật khẩu
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 auth-form-side">
                    <div class="auth-form-wrap">
                        <div class="auth-form-header auth-slide-up">
                            <span class="auth-icon-circle auth-icon-teal"><i class="bi bi-key-fill"></i></span>
                            <h2>Quên mật khẩu</h2>
                            <p>Nhập email để nhận liên kết đặt lại mật khẩu.</p>
                        </div>

                        <form asp-action="ForgotPassword" method="post" class="auth-slide-up auth-fade-delay-1">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">Email</label>
                                <div class="input-group auth-input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" placeholder="email@example.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-auth-primary w-100">
                                <span>GỬI LIÊN KẾT</span>
                                <i class="bi bi-send"></i>
                            </button>
                        </form>

                        <p class="auth-switch-text auth-fade-delay-3">
                            Đã nhớ mật khẩu?
                            <a asp-action="Login" class="auth-link-orange fw-semibold">Đăng nhập lại</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
