@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_Layout";
}

<section class="auth-page auth-page-login">
    <div class="container">
        <div class="auth-hero-card auth-animate-in">
            <div class="row g-0 align-items-stretch">
                <div class="col-lg-6 auth-visual auth-visual-login">
                    <div class="auth-visual-content">
                        <img src="/images/dangnhap.jpg" alt="KikiAzoo Pets" class="auth-hero-img auth-float" />
                        <div class="auth-visual-badge auth-fade-delay-1">
                            <i class="bi bi-heart-fill"></i> Thú cưng là gia đình
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 auth-form-side">
                    <div class="auth-form-wrap">
                        <div class="auth-form-header auth-slide-up">
                            <span class="auth-icon-circle auth-icon-teal"><i class="bi bi-person-circle"></i></span>
                            <h2>Đăng nhập</h2>
                            <p>Chào mừng bạn quay trở lại KikiAzoo!</p>
                        </div>

                        <form asp-action="Login" method="post" class="auth-slide-up auth-fade-delay-1">
                            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">Email</label>
                                <div class="input-group auth-input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" placeholder="email@example.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">Mật khẩu</label>
                                <div class="input-group auth-input-group">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Password" class="form-control" id="loginPassword" placeholder="••••••••" />
                                    <button type="button" class="input-group-text btn-toggle-password" onclick="togglePassword('loginPassword', this)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input asp-for="RememberMe" class="form-check-input" />
                                    <label asp-for="RememberMe" class="form-check-label small">Ghi nhớ đăng nhập</label>
                                </div>
                                <a asp-action="ForgotPassword" class="small auth-link-teal">Quên mật khẩu?</a>
                            </div>

                            <button type="submit" class="btn btn-auth-primary w-100">
                                <span>ĐĂNG NHẬP</span>
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        </form>

                        <div class="auth-divider auth-fade-delay-2"><span>hoặc</span></div>

                        <div class="auth-social-coming-soon auth-fade-delay-2">
                            <button type="button" class="btn btn-social flex-fill" disabled title="Sắp ra mắt">
                                <i class="bi bi-facebook"></i> Facebook
                            </button>
                            <button type="button" class="btn btn-social flex-fill" disabled title="Sắp ra mắt">
                                <i class="bi bi-google"></i> Google
                            </button>
                        </div>
                        <p class="text-center small text-muted mt-2 auth-fade-delay-2">Đăng nhập mạng xã hội sắp ra mắt</p>

                        <p class="auth-switch-text auth-fade-delay-3">
                            Chưa có tài khoản?
                            <a asp-action="Register" class="auth-link-orange fw-semibold">Đăng ký ngay</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
