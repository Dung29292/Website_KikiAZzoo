@{
    ViewData["Title"] = "Câu hỏi thường gặp";
}

<div class="container py-5">
    <h1 class="fw-bold mb-4">Câu hỏi thường gặp (FAQ)</h1>
    <div class="accordion" id="faqAccordion">
        <div class="accordion-item auth-card border-0 mb-3">
            <h2 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                    Làm sao để đặt hàng trên KikiAzoo?
                </button>
            </h2>
            <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-muted">
                    Chọn sản phẩm → Thêm vào giỏ hàng → Tiến hành thanh toán → Điền địa chỉ giao hàng → Xác nhận đơn hàng.
                </div>
            </div>
        </div>
        <div class="accordion-item auth-card border-0 mb-3">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                    Phí vận chuyển là bao nhiêu?
                </button>
            </h2>
            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-muted">
                    Miễn phí vận chuyển cho đơn hàng từ 300.000đ. Đơn dưới 300.000đ phí ship 30.000đ.
                </div>
            </div>
        </div>
        <div class="accordion-item auth-card border-0 mb-3">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                    Tôi có thể đổi/trả hàng không?
                </button>
            </h2>
            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-muted">
                    Có, trong vòng 7 ngày kể từ khi nhận hàng. Xem chi tiết tại <a asp-action="ReturnPolicy">Chính sách đổi trả</a>.
                </div>
            </div>
        </div>
        <div class="accordion-item auth-card border-0 mb-3">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                    Sản phẩm có chính hãng không?
                </button>
            </h2>
            <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-muted">
                    100% sản phẩm chính hãng, có nguồn gốc xuất xứ rõ ràng và tem phân phối đầy đủ.
                </div>
            </div>
        </div>
    </div>
</div>
