}

<div class="container py-5">
    <h1 class="fw-bold mb-4">Chính sách đổi trả</h1>
    <div class="auth-card">
        <h5>Điều kiện đổi/trả</h5>
        <ul class="text-muted">
            <li>Sản phẩm còn nguyên seal, chưa qua sử dụng</li>
