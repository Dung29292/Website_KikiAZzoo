@{
    ViewData["Title"] = "Về chúng tôi";
}

<div class="container py-5">
    <h1 class="fw-bold text-center mb-5">Về chúng tôi</h1>
    <div class="row align-items-center g-5 mb-5">
        <div class="col-md-6">
            <img src="/images/family.png" alt="KikiAzoo Family" class="img-fluid rounded-4 shadow-sm" style="max-height: 350px; object-fit: cover; width: 100%;" />
        </div>
        <div class="col-md-6">
            <h3 class="fw-bold">KikiAzoo - Ngôi nhà thứ hai của thú cưng</h3>
            <p class="text-muted">KikiAzoo được thành lập với sứ mệnh mang đến những sản phẩm chất lượng nhất cho thú cưng Việt Nam. Chúng tôi tin rằng mỗi thú cưng đều xứng đáng được yêu thương và chăm sóc tốt nhất.</p>
            <p class="text-muted">Đội ngũ của chúng tôi gồm những chuyên gia giàu kinh nghiệm, luôn sẵn sàng tư vấn và hỗ trợ bạn trong hành trình chăm sóc người bạn bốn chân.</p>
        </div>
    </div>
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="about-stats">
                <h3>+10.000</h3>
                <p>Khách hàng hài lòng</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="about-stats">
                <h3>+2.000</h3>
                <p>Sản phẩm đa dạng</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="about-stats">
                <h3>+5</h3>
                <p>Năm kinh nghiệm</p>
            </div>
        </div>
    </div>
    <blockquote class="text-center fst-italic fs-5 text-muted border-start border-4 border-teal ps-4" style="border-color:var(--teal)!important;">
        "Thú cưng không chỉ là vật nuôi, mà là thành viên trong gia đình."
    </blockquote>
</div>
