@{
    ViewData["Title"] = "Liên hệ";
}

<div class="container py-5 contact-page">
    <div class="text-center mb-5">
        <h1 class="fw-bold">Liên hệ với chúng tôi</h1>
        <p class="text-muted">Chúng tôi luôn sẵn sàng lắng nghe và hỗ trợ bạn</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="contact-info-card">
                <div class="contact-info-icon"><i class="bi bi-geo-alt"></i></div>
                <h6 class="fw-bold">Địa chỉ</h6>
                <p class="text-muted small mb-0">74 đường số 1,gò vấp, TP.HCM</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="contact-info-card">
                <div class="contact-info-icon"><i class="bi bi-telephone"></i></div>
                <h6 class="fw-bold">Hotline</h6>
                <p class="text-muted small mb-0">1900 1234</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="contact-info-card">
                <div class="contact-info-icon"><i class="bi bi-envelope"></i></div>
                <h6 class="fw-bold">Email</h6>
                <p class="text-muted small mb-0">contact@kikiazoo.com</p>
            </div>
        </div>
    </div>

    <div class="row g-5">
        <div class="col-lg-6">
            <div class="checkout-card">
                <h5 class="checkout-section-title mb-4"><i class="bi bi-chat-dots"></i> Gửi tin nhắn</h5>
                <form id="contactForm">
                    <div class="mb-3">
                        <label class="form-label">Họ tên <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="contactName" required placeholder="Nguyễn Văn A" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" id="contactEmail" required placeholder="email@example.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Chủ đề</label>
                        <select class="form-select" id="contactSubject">
                            <option value="general">Hỏi đáp chung</option>
                            <option value="adoption">Nhận nuôi thú cưng</option>
                            <option value="service">Đặt lịch dịch vụ</option>
                            <option value="order">Đơn hàng / Giao hàng</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Nội dung <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="contactMessage" rows="5" required placeholder="Nội dung tin nhắn của bạn..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-teal btn-lg w-100">
                        <i class="bi bi-send"></i> Gửi tin nhắn
                    </button>
                </form>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="contact-map-placeholder">
                <i class="bi bi-map"></i>
                <p class="mb-0">123 Đường Pet, Quận 1, TP.HCM</p>
            </div>
            <div class="contact-hours mt-4">
                <h6 class="fw-bold"><i class="bi bi-clock text-teal"></i> Giờ làm việc</h6>
                <p class="text-muted mb-1">Thứ 2 – Chủ nhật: 8:00 – 22:00</p>
                <p class="text-muted small">Phản hồi email trong vòng 24 giờ làm việc</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('contactForm')?.addEventListener('submit', function(e) {
        e.preventDefault();
        ToastNotification.success('Đã gửi!', 'Cảm ơn bạn! Chúng tôi sẽ phản hồi sớm nhất có thể.');
        this.reset();
    });
</script>
}
