@{
    ViewData["Title"] = "Hướng dẫn mua hàng";
}

<div class="container py-5">
    <h1 class="fw-bold mb-4">Hướng dẫn mua hàng</h1>
    <div class="row g-4">
        <div class="col-md-3">
            <div class="service-card">
                <div class="rounded-circle bg-teal-light d-inline-flex align-items-center justify-content-center mb-3" style="width:60px;height:60px;background:var(--cream);">
                    <span class="fw-bold fs-4 text-teal-custom">1</span>
                </div>
                <h6>Tìm sản phẩm</h6>
                <p class="text-muted small">Duyệt danh mục hoặc tìm kiếm sản phẩm phù hợp cho thú cưng.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="service-card">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:60px;height:60px;background:var(--cream);">
                    <span class="fw-bold fs-4" style="color:var(--teal)">2</span>
                </div>
                <h6>Thêm vào giỏ</h6>
                <p class="text-muted small">Chọn số lượng và nhấn "Thêm vào giỏ hàng".</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="service-card">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:60px;height:60px;background:var(--cream);">
                    <span class="fw-bold fs-4" style="color:var(--teal)">3</span>
                </div>
                <h6>Thanh toán</h6>
                <p class="text-muted small">Đăng nhập, điền địa chỉ giao hàng và xác nhận đơn.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="service-card">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:60px;height:60px;background:var(--cream);">
                    <span class="fw-bold fs-4" style="color:var(--teal)">4</span>
                </div>
                <h6>Nhận hàng</h6>
                <p class="text-muted small">Theo dõi đơn hàng tại mục "Đơn hàng của tôi".</p>
            </div>
        </div>
    </div>
</div>
