@{
    ViewData["Title"] = "Chính sách vận chuyển";
}

<div class="container py-5">
    <h1 class="fw-bold mb-4">Chính sách vận chuyển</h1>
    <div class="auth-card">
        <h5>Phạm vi giao hàng</h5>
        <p class="text-muted">Giao hàng toàn quốc qua các đối tác vận chuyển uy tín (GHN, GHTK, Viettel Post).</p>

        <h5 class="mt-4">Thời gian giao hàng</h5>
        <ul class="text-muted">
            <li>Nội thành TP.HCM, Hà Nội: 1-2 ngày</li>
            <li>Các tỉnh thành khác: 3-5 ngày</li>
            <li>Vùng sâu vùng xa: 5-7 ngày</li>
        </ul>

        <h5 class="mt-4">Phí vận chuyển</h5>
        <ul class="text-muted">
            <li>Miễn phí cho đơn hàng từ 300.000đ</li>
            <li>Đơn dưới 300.000đ: phí 30.000đ</li>
        </ul>
    </div>
</div>
