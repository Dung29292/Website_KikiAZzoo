@model Product
@{
    ViewData["Title"] = Model.Name;
    var features = Model.Features?.OrderBy(f => f.SortOrder).ToList() ?? new List<ProductFeature>();
    var images = new List<string>();
    if (!string.IsNullOrEmpty(Model.ImageUrl)) images.Add(Model.ImageUrl);
    if (Model.Images?.Any() == true)
        images.AddRange(Model.Images.Select(i => i.Url).Where(u => !string.IsNullOrEmpty(u)));
    images = images.Distinct().ToList();
}

<div class="container py-4">
    <nav class="breadcrumb-kiki">
        <a asp-controller="Home" asp-action="Index">Trang chủ</a> &gt;
        <a asp-action="Index">Sản phẩm</a> &gt;
        @if (Model.Category?.CategoryGroup != null)
        {
            <a asp-action="Index" asp-route-categoryGroupId="@Model.Category.CategoryGroupId">@Model.Category.CategoryGroup.Name</a> @:›
        }
        @Model.Name
    </nav>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="product-gallery">
                @if (images.Any())
                {
                    <img src="@images[0]" alt="@Model.Name" class="product-detail-img" id="mainProductImage" />
                    @if (images.Count > 1)
                    {
                        <div class="product-gallery-thumbs mt-3">
                            @for (int i = 0; i < images.Count; i++)
                            {
                                <button type="button" class="product-gallery-thumb @(i == 0 ? "active" : "")" data-src="@images[i]" aria-label="Ảnh @(i + 1)">
                                    <img src="@images[i]" alt="" />
                                </button>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="img-placeholder product-detail-img" style="height:400px;"><i class="bi bi-image"></i></div>
                }
            </div>
        </div>
        <div class="col-md-6">
            @if (Model.PetType != null)
            {
                <span class="badge bg-teal-soft mb-2"><i class="bi @Model.PetType.Icon"></i> @Model.PetType.Name</span>
            }
            @if (Model.Category?.CategoryGroup != null)
            {
                <span class="badge bg-orange-soft mb-2">@Model.Category.CategoryGroup.Name</span>
            }
            <h2 class="fw-bold">@Model.Name</h2>
            <div class="rating-stars mb-2">
                @for (int i = 0; i < 5; i++)
                {
                    <i class="bi bi-star@(i < (int)Model.Rating ? "-fill" : "") text-warning"></i>
                }
                <span class="text-muted ms-1">(@Model.Rating)</span>
            </div>
            @{
                var activeCoupons = (ViewBag.ActiveCoupons as List<Coupon>) ?? new List<Coupon>();
                var eligibleCoupons = activeCoupons.Where(c => Model.Price >= c.MinOrderValue).ToList();
                Coupon? bestCoupon = null;
                decimal maxDiscount = 0;
                foreach (var c in eligibleCoupons)
                {
                    decimal disc = c.IsPercentage ? Math.Round(Model.Price * (c.DiscountValue / 100m)) : c.DiscountValue;
                    if (disc > maxDiscount)
                    {
                        maxDiscount = disc;
                        bestCoupon = c;
                    }
                }
                decimal finalPrice = Math.Max(0, Model.Price - maxDiscount);
            }

            @if (activeCoupons.Any() && bestCoupon != null && maxDiscount > 0)
            {
                <!-- Pricing & Voucher Section: Hiển thị khi Admin kích hoạt mã giảm giá -->
                <div class="pricing-card p-3 rounded-4 mb-4">
                    <!-- Giá bán (giá đã giảm) -->
                    <div class="d-flex align-items-baseline justify-content-between">
                        <div>
                            <span class="fw-bold text-dark fs-6 d-block">Giá bán:</span>
                            <small class="text-success fw-semibold">
                                <i class="bi bi-patch-check-fill me-1"></i>Đã áp dụng mã <strong>@bestCoupon.Code (@(bestCoupon.IsPercentage ? $"-{bestCoupon.DiscountValue}%" : $"-{bestCoupon.DiscountValue:#,##0}đ"))</strong>
                            </small>
                        </div>
                        <span class="product-price fs-2 text-danger fw-bold">@finalPrice.ToString("#,##0")đ</span>
                    </div>

                    <!-- Ở dưới: Giá gốc bị gạch đi -->
                    <div class="d-flex align-items-center gap-2 pt-2 mt-2 border-top border-teal-subtle">
                        <span class="text-muted fw-semibold" style="font-size: 0.9rem;">Giá gốc:</span>
                        <span class="fs-5 text-secondary fw-bold text-decoration-line-through">@Model.Price.ToString("#,##0")đ</span>
                        <span class="badge bg-secondary-subtle text-secondary small rounded-pill">Tiết kiệm @maxDiscount.ToString("#,##0")đ</span>
                    </div>

                    @if (eligibleCoupons.Any())
                    {
                        <!-- Danh sách mã giảm giá do Admin tạo đang hoạt động -->
                        <div class="coupons-suggest-box p-2.5 rounded-3 mt-3">
                            <div class="small fw-bold text-teal mb-2 d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-ticket-perforated-fill me-1"></i> Mã giảm giá ưu đãi áp dụng:</span>
                                <span class="badge bg-success-subtle text-success small">Đang kích hoạt</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var c in eligibleCoupons)
                                {
                                    <div class="badge bg-teal-subtle text-teal border border-teal px-2.5 py-1.5 rounded-3 d-flex align-items-center gap-1.5">
                                        <i class="bi bi-tag-fill text-teal"></i>
                                        <span class="font-monospace fw-bold">@c.Code</span>
                                        <span class="badge bg-teal text-white">@(c.IsPercentage ? $"Giảm {c.DiscountValue}%" : $"Giảm {c.DiscountValue:#,##0}đ")</span>
                                        @(c.MinOrderValue > 0 ? $"(Đơn từ {c.MinOrderValue:#,##0}đ)" : "")
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Khi không có mã giảm giá (Admin tắt mã): Chỉ hiển thị Giá bán thông thường -->
                <div class="pricing-card p-3 rounded-4 mb-4">
                    <span class="text-muted fw-semibold small d-block">Giá bán:</span>
                    <div class="product-price fs-2 text-teal fw-bold">@Model.Price.ToString("#,##0")đ</div>
                </div>
            }

            @if (features.Any())
            {
                <div class="mb-4 product-feature-list">
                    @foreach (var f in features)
                    {
                        <div class="feature-item"><i class="bi @f.Icon"></i> @f.Text</div>
                    }
                </div>
            }

            <!-- Product Specs & Trust Badges -->
            <div class="product-trust-box p-3 rounded-3 mb-4" style="font-size: 0.88rem;">
                @if (Model.Category?.CategoryGroup?.Name == "Thức ăn" || Model.Category?.CategoryGroup?.Name == "Chăm sóc")
                {
                    <div class="mb-2"><i class="bi bi-calendar-event text-teal me-2"></i><strong>Hạn sử dụng:</strong> 12 tháng kể từ ngày sản xuất (HSD chi tiết in trên bao bì)</div>
                    @if (!string.IsNullOrEmpty(Model.Ingredients))
                    {
                        <div class="mb-2"><i class="bi bi-journal-text text-teal me-2"></i><strong>Thành phần chính:</strong> @Model.Ingredients</div>
                    }
                }
                <div class="mb-2"><i class="bi bi-shield-check text-teal me-2"></i><strong>Đổi trả & Bảo hành:</strong> Chính sách đổi trả miễn phí trong vòng 7 ngày nếu phát hiện lỗi.</div>
                <div><i class="bi bi-truck text-teal me-2"></i><strong>Vận chuyển:</strong> Giao hàng nhanh toàn quốc, Freeship cho đơn hàng từ 300K.</div>
            </div>

            @if (Model.Category?.CategoryGroup?.Name != "Thú cưng")
            {
                <div id="product-buy-section" class="product-detail-actions d-flex gap-2 flex-wrap mb-3">
                    <a asp-controller="ShoppingCart" asp-action="AddToCart" asp-route-productId="@Model.Id" class="btn btn-teal btn-lg flex-grow-1 btn-add-cart py-3 fw-bold" style="box-shadow: 0 4px 15px rgba(13, 148, 136, 0.25);">
                        <i class="bi bi-cart-plus-fill me-1"></i> THÊM VÀO GIỎ
                    </a>
                    <a asp-controller="ShoppingCart" asp-action="AddToCart" asp-route-productId="@Model.Id" class="btn btn-orange btn-lg btn-buy-now py-3 fw-bold flex-grow-1" data-buy-now="true" style="box-shadow: 0 4px 15px rgba(242, 141, 82, 0.3);">
                        <i class="bi bi-lightning-fill me-1"></i> MUA NGAY
                    </a>
                </div>
            }
            else
            {
                <a asp-controller="Home" asp-action="Contact" class="btn btn-teal btn-lg mb-3 py-3 fw-bold w-100" style="box-shadow: 0 4px 15px rgba(13, 148, 136, 0.25);">
                    <i class="bi bi-chat-heart-fill me-1"></i> LIÊN HỆ NHẬN NUÔI
                </a>
            }

            <p class="text-muted small mb-0">
                <strong>Danh mục:</strong> @Model.Category?.CategoryGroup?.Name › @Model.Category?.Name |
                <strong>Thương hiệu:</strong> @(Model.Brand?.Name ?? "KikiAzoo")
            </p>
        </div>
    </div>

    <div class="mt-5">
        <ul class="nav nav-tabs nav-tabs-kiki" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button" role="tab" aria-controls="desc" aria-selected="true">Mô tả</button>
            </li>
            @if (!string.IsNullOrEmpty(Model.Ingredients))
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="ingredients-tab" data-bs-toggle="tab" data-bs-target="#ingredients" type="button" role="tab" aria-controls="ingredients" aria-selected="false">Thành phần</button>
                </li>
            }
            @if (!string.IsNullOrEmpty(Model.UsageGuide))
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="usage-tab" data-bs-toggle="tab" data-bs-target="#usage" type="button" role="tab" aria-controls="usage" aria-selected="false">Hướng dẫn</button>
                </li>
            }
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab" aria-controls="reviews" aria-selected="false">Đánh giá (@(((List<ProductReview>)ViewBag.Reviews).Count))</button>
            </li>
        </ul>
        <div class="tab-content p-4 border border-top-0 rounded-bottom bg-white">
            <div class="tab-pane fade show active" id="desc" role="tabpanel" aria-labelledby="desc-tab">@Html.Raw(Model.Description)</div>
            @if (!string.IsNullOrEmpty(Model.Ingredients))
            {
                <div class="tab-pane fade" id="ingredients" role="tabpanel" aria-labelledby="ingredients-tab">@Model.Ingredients</div>
            }
            @if (!string.IsNullOrEmpty(Model.UsageGuide))
            {
                <div class="tab-pane fade" id="usage" role="tabpanel" aria-labelledby="usage-tab">@Model.UsageGuide</div>
            }
            <div class="tab-pane fade" id="reviews" role="tabpanel" aria-labelledby="reviews-tab">
                <div class="row g-4">
                    <!-- Reviews list -->
                    <div class="col-lg-7">
                        <h5 class="fw-bold mb-3"><i class="bi bi-chat-text text-teal"></i> Khách hàng nhận xét</h5>
                        
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                                <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (!((List<ProductReview>)ViewBag.Reviews).Any())
                        {
                            <div class="text-center py-4 bg-light rounded-4 border">
                                <i class="bi bi-chat-heart text-teal fs-2 d-block mb-2"></i>
                                <p class="text-muted mb-0">Chưa có đánh giá nào cho sản phẩm này. Hãy là người đầu tiên đánh giá!</p>
                            </div>
                        }
                        else
                        {
                            <div class="reviews-list d-flex flex-column gap-3">
                                @foreach (var review in (List<ProductReview>)ViewBag.Reviews)
                                {
                                    <div class="review-card p-3 rounded-4 bg-light border shadow-sm">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                                    <strong class="text-dark">@(review.ApplicationUser?.FullName ?? "Khách hàng")</strong>
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0" style="font-size: 0.72rem;">
                                                        <i class="bi bi-patch-check-fill"></i> Đã mua hàng
                                                    </span>
                                                </div>
                                                <small class="text-muted small">@review.CreatedDate.ToString("dd/MM/yyyy HH:mm")</small>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="text-warning" style="font-size: 0.9rem;">
                                                    @for (int s = 1; s <= 5; s++)
                                                    {
                                                        <i class="bi bi-star@(s <= review.Rating ? "-fill" : "")"></i>
                                                    }
                                                </div>
                                                @if (User.Identity?.IsAuthenticated == true && (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == review.UserId || User.IsInRole(SD.Role_Admin)))
                                                {
                                                    <form asp-controller="ProductReview" asp-action="DeleteReview" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa đánh giá này?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="reviewId" value="@review.Id" />
                                                        <input type="hidden" name="productId" value="@Model.Id" />
                                                        <button type="submit" class="btn btn-sm btn-link text-danger p-0 border-0 ms-1" title="Xóa đánh giá">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                        <p class="mb-2 text-dark small" style="white-space: pre-line;">@review.Content</p>

                                        <!-- Actions / Reply Trigger -->
                                        <div class="d-flex align-items-center justify-content-between pt-2 border-top border-1 mt-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <button type="button" class="btn btn-sm btn-link text-decoration-none text-teal p-0 fw-semibold btn-toggle-reply" data-review-id="@review.Id">
                                                    <i class="bi bi-reply-fill"></i> Trả lời
                                                </button>
                                                @if (review.Replies != null && review.Replies.Any())
                                                {
                                                    <span class="text-muted small">· @review.Replies.Count phản hồi</span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Replies Thread -->
                                        @if (review.Replies != null && review.Replies.Any())
                                        {
                                            <div class="replies-list mt-3 ps-3 border-start border-3 border-teal d-flex flex-column gap-2">
                                                @foreach (var reply in review.Replies.OrderBy(r => r.CreatedDate))
                                                {
                                                    <div class="reply-item p-2.5 rounded-3 bg-white border small">
                                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                                <strong class="text-dark">@(reply.ApplicationUser?.FullName ?? "Người dùng")</strong>
                                                                @if (reply.IsStaffReply)
                                                                {
                                                                    <span class="badge bg-teal text-white rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">
                                                                        <i class="bi bi-shop"></i> KikiAZZoo Store
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-light text-secondary border rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">
                                                                        Khách hàng
                                                                    </span>
                                                                }
                                                                <small class="text-muted" style="font-size: 0.75rem;">@reply.CreatedDate.ToString("dd/MM/yyyy HH:mm")</small>
                                                            </div>
                                                            @if (User.Identity?.IsAuthenticated == true && (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == reply.UserId || User.IsInRole(SD.Role_Admin)))
                                                            {
                                                                <form asp-controller="ProductReview" asp-action="DeleteReply" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa phản hồi này?');">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="replyId" value="@reply.Id" />
                                                                    <input type="hidden" name="productId" value="@Model.Id" />
                                                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0 border-0" title="Xóa phản hồi">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </form>
                                                            }
                                                        </div>
                                                        <div class="text-dark" style="white-space: pre-line;">@reply.Content</div>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <!-- Reply Form (Hidden by default, shown when clicking 'Trả lời') -->
                                        <div id="reply-form-@review.Id" class="reply-form-box mt-3 d-none">
                                            @if (User.Identity?.IsAuthenticated == true)
                                            {
                                                <form asp-controller="ProductReview" asp-action="AddReply" method="post" class="p-3 bg-white rounded-3 border shadow-sm">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="reviewId" value="@review.Id" />
                                                    <input type="hidden" name="productId" value="@Model.Id" />
                                                    <div class="mb-2">
                                                        <label class="form-label small fw-semibold text-muted mb-1">
                                                            <i class="bi bi-chat-dots text-teal"></i> Viết câu trả lời cho @(review.ApplicationUser?.FullName ?? "khách hàng"):
                                                        </label>
                                                        <textarea name="content" class="form-control form-control-sm" rows="2" placeholder="Nhập nội dung phản hồi..." required minlength="2"></textarea>
                                                    </div>
                                                    <div class="d-flex justify-content-end gap-2">
                                                        <button type="button" class="btn btn-sm btn-light border btn-cancel-reply" data-review-id="@review.Id">Hủy</button>
                                                        <button type="submit" class="btn btn-sm btn-teal rounded-pill px-3">Gửi phản hồi</button>
                                                    </div>
                                                </form>
                                            }
                                            else
                                            {
                                                <div class="p-3 bg-white rounded-3 border text-center small shadow-sm">
                                                    <span class="text-muted">Vui lòng </span>
                                                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Product", new { id = Model.Id })" class="text-teal fw-semibold">đăng nhập</a>
                                                    <span class="text-muted"> để gửi phản hồi cho đánh giá này.</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Add Review Form -->
                    <div class="col-lg-5">
                        <div class="bg-light p-4 rounded-4 border shadow-sm sticky-top" style="top: 100px;">
                            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-pencil-square text-teal"></i> Viết đánh giá của bạn</h5>
                            
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @if (ViewBag.HasPurchased == true || User.IsInRole(SD.Role_Admin))
                                {
                                    <form asp-controller="ProductReview" asp-action="AddReview" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@Model.Id" />

                                        <div class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 mb-3 small d-inline-block">
                                            <i class="bi bi-patch-check-fill"></i> Đã mua hàng (Đủ điều kiện đánh giá)
                                        </div>

                                        <!-- Rating selection -->
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold">Chọn số sao đánh giá</label>
                                            <div class="rating-picker d-flex gap-2 text-warning fs-4">
                                                <i class="bi bi-star-fill rating-star" data-value="1" style="cursor:pointer;"></i>
                                                <i class="bi bi-star-fill rating-star" data-value="2" style="cursor:pointer;"></i>
                                                <i class="bi bi-star-fill rating-star" data-value="3" style="cursor:pointer;"></i>
                                                <i class="bi bi-star-fill rating-star" data-value="4" style="cursor:pointer;"></i>
                                                <i class="bi bi-star-fill rating-star" data-value="5" style="cursor:pointer;"></i>
                                            </div>
                                            <input type="hidden" name="rating" id="ratingInputValue" value="5" />
                                        </div>

                                        <!-- Content -->
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold">Nội dung nhận xét</label>
                                            <textarea name="content" class="form-control" rows="4" placeholder="Chia sẻ trải nghiệm thực tế của bạn về sản phẩm này..." required minlength="5"></textarea>
                                        </div>

                                        <button type="submit" class="btn btn-teal rounded-pill px-4 btn-sm w-100 fw-semibold">
                                            Gửi nhận xét
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <div class="text-center py-4 px-2">
                                        <div class="mb-3 text-warning">
                                            <i class="bi bi-shield-lock-fill" style="font-size: 2.8rem;"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-2">Chỉ người mua mới được đánh giá</h6>
                                        <p class="text-muted small mb-3">
                                            Để đảm bảo tính khách quan và trải nghiệm thực tế, chỉ khách hàng đã từng mua sản phẩm này thành công mới có thể gửi đánh giá và nhận xét.
                                        </p>
                                        <a href="#product-buy-section" class="btn btn-sm btn-outline-teal rounded-pill px-4">
                                            <i class="bi bi-cart-plus me-1"></i> Mua ngay sản phẩm
                                        </a>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-4">
                                    <div class="mb-3 text-muted">
                                        <i class="bi bi-person-lock" style="font-size: 2.5rem;"></i>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-2">Đăng nhập để đánh giá</h6>
                                    <p class="text-muted small mb-3">Vui lòng đăng nhập bằng tài khoản đã mua hàng để gửi nhận xét và số sao.</p>
                                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Product", new { id = Model.Id })" class="btn btn-teal btn-sm rounded-pill px-4 fw-semibold">Đăng nhập</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Gallery thumbs clicker
            document.querySelectorAll('.product-gallery-thumb').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.getElementById('mainProductImage').src = btn.dataset.src;
                    document.querySelectorAll('.product-gallery-thumb').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                });
            });

            // Rating picker script
            const stars = document.querySelectorAll('.rating-star');
            const input = document.getElementById('ratingInputValue');
            if (stars.length > 0 && input) {
                stars.forEach(star => {
                    star.addEventListener('click', function () {
                        const val = parseInt(this.dataset.value);
                        input.value = val;
                        stars.forEach((s, idx) => {
                            if (idx < val) {
                                s.classList.remove('bi-star');
                                s.classList.add('bi-star-fill');
                            } else {
                                s.classList.remove('bi-star-fill');
                                s.classList.add('bi-star');
                            }
                        });
                    });
                });
            }

            // Reply toggle handlers
            document.querySelectorAll('.btn-toggle-reply').forEach(btn => {
                btn.addEventListener('click', function () {
                    const reviewId = this.dataset.reviewId;
                    const formBox = document.getElementById(`reply-form-${reviewId}`);
                    if (formBox) {
                        formBox.classList.toggle('d-none');
                        if (!formBox.classList.contains('d-none')) {
                            const textarea = formBox.querySelector('textarea');
                            if (textarea) textarea.focus();
                        }
                    }
                });
            });

            document.querySelectorAll('.btn-cancel-reply').forEach(btn => {
                btn.addEventListener('click', function () {
                    const reviewId = this.dataset.reviewId;
                    const formBox = document.getElementById(`reply-form-${reviewId}`);
                    if (formBox) {
                        formBox.classList.add('d-none');
                    }
                });
            });
        });
    </script>
}
