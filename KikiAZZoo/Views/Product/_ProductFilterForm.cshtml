@model ProductListViewModel
@{
    var prefix = ViewData["FilterPrefix"] as string ?? "";
    var hasFilters = Model.CategoryGroupId.HasValue || Model.CategoryId.HasValue || Model.PetTypeId.HasValue
        || Model.BrandId.HasValue || Model.PriceRangeId.HasValue || !string.IsNullOrEmpty(Model.Search)
        || !string.IsNullOrEmpty(Model.StatusFilter) || Model.RatingFilter.HasValue
        || !string.IsNullOrEmpty(Model.PetAge) || !string.IsNullOrEmpty(Model.FoodType);
}

<form method="get" asp-action="Index" id="filterForm@(prefix)" class="filter-form-modern">
    <input type="hidden" name="sortBy" value="@Model.SortBy" />

    <!-- Search box -->
    <div class="filter-search-box">
        <i class="ph ph-magnifying-glass"></i>
        <input type="text" name="search" value="@Model.Search" placeholder="Tìm sản phẩm, thức ăn..." />
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <a asp-action="Index" class="filter-search-clear" title="Xóa từ khóa"><i class="ph ph-x-circle"></i></a>
        }
    </div>

    <!-- Quick Reset Banner if active filters -->
    @if (hasFilters)
    {
        <div class="filter-quick-reset-banner d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-1 small text-danger fw-semibold">
                <i class="ph-fill ph-funnel"></i>
                <span>Đang lọc</span>
            </div>
            <a asp-action="Index" class="btn btn-sm btn-outline-danger py-0 px-2 rounded-pill fw-bold" style="font-size: 0.75rem;">
                <i class="ph ph-arrow-counter-clockwise me-1"></i>Xóa lọc
            </a>
        </div>
    }

    <!-- Quick link to Pet Shop -->
    <div class="p-3 mb-3 rounded-4" style="background: linear-gradient(135deg, rgba(13,148,136,0.08), rgba(249,115,22,0.08)); border: 1px dashed rgba(13,148,136,0.3);">
        <div class="d-flex align-items-center gap-2 mb-1">
            <i class="ph-fill ph-paw-print text-teal fs-6"></i>
            <span class="small fw-bold text-dark">Bạn tìm mua thú cưng?</span>
        </div>
        <p class="small text-muted mb-2" style="font-size: 0.78rem; line-height: 1.4;">
            Xem gian hàng cún, mèo và cá cảnh thuần chủng có bảo hành.
        </p>
        <a asp-controller="PetShop" asp-action="Index" class="btn btn-sm btn-teal w-100 rounded-pill fw-semibold py-1" style="font-size: 0.8rem;">
            Đến gian hàng Thú cưng <i class="ph ph-arrow-right ms-1"></i>
        </a>
    </div>

    <!-- 1. Loại thú cưng -->
    <div class="filter-section">
        <div class="filter-section-title d-flex align-items-center justify-content-between">
            <span><i class="ph-fill ph-paw-print"></i> Dành cho thú cưng</span>
            @if (Model.PetTypeId.HasValue)
            {
                <span class="badge bg-teal text-white rounded-pill" style="font-size: 0.7rem;">1 đã chọn</span>
            }
        </div>
        <div class="filter-options">
            <div class="filter-chip @(Model.PetTypeId == null ? "active" : "")">
                <input type="radio" name="petTypeId" value="" id="petAll@(prefix)" @(Model.PetTypeId == null ? "checked" : "") onchange="this.form.submit()" />
                <label for="petAll@(prefix)">Tất cả</label>
            </div>
            @foreach (var petType in Model.PetTypes)
            {
                <div class="filter-chip @(Model.PetTypeId == petType.Id ? "active" : "")">
                    <input type="radio" name="petTypeId" value="@petType.Id" id="pet@(prefix)@petType.Id" @(Model.PetTypeId == petType.Id ? "checked" : "") onchange="this.form.submit()" />
                    <label for="pet@(prefix)@petType.Id">
                        <i class="bi @petType.Icon"></i> @petType.Name
                    </label>
                </div>
            }
        </div>
    </div>

    <!-- 2. Danh mục sản phẩm -->
    <div class="filter-section">
        <div class="filter-section-title d-flex align-items-center justify-content-between mb-2">
            <span><i class="ph ph-squares-four"></i> Danh mục sản phẩm</span>
            @if (Model.CategoryGroupId.HasValue || Model.CategoryId.HasValue)
            {
                <span class="badge bg-teal text-white rounded-pill px-2 py-1" style="font-size: 0.68rem;">1 đang chọn</span>
            }
        </div>
        <div class="filter-category-groups-wrapper">
            @foreach (var group in Model.CategoryGroups.Where(g => g.Name != "Thú cưng"))
            {
                var isFoodGroup = group.Name.Contains("Thức ăn", StringComparison.OrdinalIgnoreCase);
                var isGroupActive = Model.CategoryGroupId == group.Id 
                    || (group.Categories != null && group.Categories.Any(c => c.Id == Model.CategoryId))
                    || (isFoodGroup && !string.IsNullOrEmpty(Model.FoodType));
                var collapseId = $"collapseCat{prefix}{group.Id}";
                var categoriesCount = (group.Categories?.Count ?? 0) + 1;

                <div class="filter-category-dropdown @(isGroupActive ? "is-active" : "") mb-1">
                    <!-- Dropdown Toggle Header -->
                    <button type="button" 
                            class="filter-category-header @(isGroupActive ? "" : "collapsed")" 
                            data-bs-toggle="collapse" 
                            data-bs-target="#@collapseId" 
                            aria-expanded="@(isGroupActive ? "true" : "false")" 
                            aria-controls="@collapseId">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-chevron-right filter-category-caret"></i>
                            <span class="filter-category-name">@group.Name</span>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            @if (isGroupActive)
                            {
                                <span class="badge bg-teal-subtle text-teal border border-teal rounded-pill px-2 py-0" style="font-size: 0.65rem;">Đang chọn</span>
                            }
                            else
                            {
                                <span class="category-count-badge">@categoriesCount</span>
                            }
                        </div>
                    </button>

                    <!-- Collapsible Subcategories Content -->
                    <div class="collapse @(isGroupActive ? "show" : "")" id="@collapseId">
                        <div class="filter-category-body">
                            <div class="filter-options filter-options-scaled">
                                <div class="filter-chip filter-chip-sm @(Model.CategoryGroupId == group.Id && !Model.CategoryId.HasValue ? "active" : "")">
                                    <input type="radio" name="categoryGroupId" value="@group.Id" id="grp@(prefix)@group.Id" @(Model.CategoryGroupId == group.Id && !Model.CategoryId.HasValue ? "checked" : "") onchange="this.form.submit()" />
                                    <label for="grp@(prefix)@group.Id">
                                        <i class="bi bi-grid-fill me-1" style="font-size: 0.68rem;"></i>Tất cả @group.Name
                                    </label>
                                </div>
                                @foreach (var category in group.Categories ?? [])
                                {
                                    <div class="filter-chip filter-chip-sm @(Model.CategoryId == category.Id ? "active" : "")">
                                        <input type="radio" name="categoryId" value="@category.Id" id="cat@(prefix)@category.Id" @(Model.CategoryId == category.Id ? "checked" : "") onchange="this.form.submit()" />
                                        <label for="cat@(prefix)@category.Id">@category.Name</label>
                                    </div>
                                }
                            </div>

                            @if (isFoodGroup)
                            {
                                <div class="filter-food-type-box mt-2 pt-2 border-top">
                                    <div class="filter-food-type-title mb-1">
                                        <i class="ph ph-bowl-food text-teal me-1"></i>Dạng chế biến:
                                        @if (!string.IsNullOrEmpty(Model.FoodType))
                                        {
                                            <span class="badge bg-teal text-white rounded-pill px-1 ms-1" style="font-size: 0.62rem;">Đã chọn</span>
                                        }
                                    </div>
                                    <div class="filter-options filter-options-scaled">
                                        <div class="filter-chip filter-chip-sm @(Model.FoodType == null ? "active" : "")">
                                            <input type="radio" name="foodType" value="" id="foodAll@(prefix)" @(Model.FoodType == null ? "checked" : "") onchange="this.form.submit()" />
                                            <label for="foodAll@(prefix)">Tất cả</label>
                                        </div>
                                        <div class="filter-chip filter-chip-sm @(Model.FoodType == "hat" ? "active" : "")">
                                            <input type="radio" name="foodType" value="hat" id="foodHat@(prefix)" @(Model.FoodType == "hat" ? "checked" : "") onchange="this.form.submit()" />
                                            <label for="foodHat@(prefix)">Thức ăn hạt</label>
                                        </div>
                                        <div class="filter-chip filter-chip-sm @(Model.FoodType == "pate" ? "active" : "")">
                                            <input type="radio" name="foodType" value="pate" id="foodPate@(prefix)" @(Model.FoodType == "pate" ? "checked" : "") onchange="this.form.submit()" />
                                            <label for="foodPate@(prefix)">Pate / Đồ ướt</label>
                                        </div>
                                        <div class="filter-chip filter-chip-sm @(Model.FoodType == "snack" ? "active" : "")">
                                            <input type="radio" name="foodType" value="snack" id="foodSnack@(prefix)" @(Model.FoodType == "snack" ? "checked" : "") onchange="this.form.submit()" />
                                            <label for="foodSnack@(prefix)">Snack / Bánh thưởng</label>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- 3. Độ tuổi thú cưng (dời ngay dưới phần danh mục) -->
    <div class="filter-section">
        <div class="filter-section-title d-flex align-items-center justify-content-between mb-2">
            <span><i class="ph ph-baby"></i> Độ tuổi thú cưng</span>
            @if (!string.IsNullOrEmpty(Model.PetAge))
            {
                <span class="badge bg-teal text-white rounded-pill px-2 py-1" style="font-size: 0.68rem;">1 đang chọn</span>
            }
        </div>
        <div class="filter-options filter-options-scaled">
            <div class="filter-chip filter-chip-sm @(Model.PetAge == null ? "active" : "")">
                <input type="radio" name="petAge" value="" id="ageAll@(prefix)" @(Model.PetAge == null ? "checked" : "") onchange="this.form.submit()" />
                <label for="ageAll@(prefix)">Tất cả</label>
            </div>
            <div class="filter-chip filter-chip-sm @(Model.PetAge == "young" ? "active" : "")">
                <input type="radio" name="petAge" value="young" id="ageYoung@(prefix)" @(Model.PetAge == "young" ? "checked" : "") onchange="this.form.submit()" />
                <label for="ageYoung@(prefix)"><i class="ph ph-baby me-1"></i>Con non / Nhỏ</label>
            </div>
            <div class="filter-chip filter-chip-sm @(Model.PetAge == "adult" ? "active" : "")">
                <input type="radio" name="petAge" value="adult" id="ageAdult@(prefix)" @(Model.PetAge == "adult" ? "checked" : "") onchange="this.form.submit()" />
                <label for="ageAdult@(prefix)"><i class="ph ph-paw-print me-1"></i>Trưởng thành</label>
            </div>
        </div>
    </div>

    <!-- 3. Khoảng giá -->
    <div class="filter-section">
        <div class="filter-section-title d-flex align-items-center justify-content-between">
            <span><i class="ph ph-currency-circle-dollar"></i> Khoảng giá</span>
            @if (Model.PriceRangeId.HasValue)
            {
                <span class="badge bg-teal text-white rounded-pill" style="font-size: 0.7rem;">1 đã chọn</span>
            }
        </div>
        <div class="filter-options">
            <div class="filter-chip @(Model.PriceRangeId == null ? "active" : "")">
                <input type="radio" name="priceRangeId" value="" id="priceAll@(prefix)" @(Model.PriceRangeId == null ? "checked" : "") onchange="this.form.submit()" />
                <label for="priceAll@(prefix)">Tất cả mức giá</label>
            </div>
            @foreach (var priceRange in Model.PriceRanges)
            {
                <div class="filter-chip @(Model.PriceRangeId == priceRange.Id ? "active" : "")">
                    <input type="radio" name="priceRangeId" value="@priceRange.Id" id="price@(prefix)@priceRange.Id" @(Model.PriceRangeId == priceRange.Id ? "checked" : "") onchange="this.form.submit()" />
                    <label for="price@(prefix)@priceRange.Id">@priceRange.Label</label>
                </div>
            }
        </div>
    </div>

    <!-- 4. Thương hiệu -->
    @if (Model.Brands.Any())
    {
        <div class="filter-section">
            <div class="filter-section-title d-flex align-items-center justify-content-between">
                <span><i class="ph ph-tag"></i> Thương hiệu</span>
                @if (Model.BrandId.HasValue)
                {
                    <span class="badge bg-teal text-white rounded-pill" style="font-size: 0.7rem;">1 đã chọn</span>
                }
            </div>
            <div class="filter-scroll-container" style="max-height: 160px;">
                <div class="filter-options">
                    <div class="filter-chip @(Model.BrandId == null ? "active" : "")">
                        <input type="radio" name="brandId" value="" id="brandAll@(prefix)" @(Model.BrandId == null ? "checked" : "") onchange="this.form.submit()" />
                        <label for="brandAll@(prefix)">Tất cả</label>
                    </div>
                    @foreach (var brand in Model.Brands)
                    {
                        <div class="filter-chip @(Model.BrandId == brand.Id ? "active" : "")">
                            <input type="radio" name="brandId" value="@brand.Id" id="brand@(prefix)@brand.Id" @(Model.BrandId == brand.Id ? "checked" : "") onchange="this.form.submit()" />
                            <label for="brand@(prefix)@brand.Id">@brand.Name</label>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- 5. Tình trạng sản phẩm -->
    <div class="filter-section">
        <div class="filter-section-title d-flex align-items-center justify-content-between">
            <span><i class="ph ph-seal-check"></i> Tình trạng</span>
            @if (!string.IsNullOrEmpty(Model.StatusFilter))
            {
                <span class="badge bg-teal text-white rounded-pill" style="font-size: 0.7rem;">1 đã chọn</span>
            }
        </div>
        <div class="filter-options">
            <div class="filter-chip @(Model.StatusFilter == null ? "active" : "")">
                <input type="radio" name="statusFilter" value="" id="statusAll@(prefix)" @(Model.StatusFilter == null ? "checked" : "") onchange="this.form.submit()" />
                <label for="statusAll@(prefix)">Tất cả</label>
            </div>
            <div class="filter-chip @(Model.StatusFilter == "sale" ? "active" : "")">
                <input type="radio" name="statusFilter" value="sale" id="statusSale@(prefix)" @(Model.StatusFilter == "sale" ? "checked" : "") onchange="this.form.submit()" />
                <label for="statusSale@(prefix)"><i class="ph-fill ph-percent text-danger"></i> Giảm giá</label>
            </div>
            <div class="filter-chip @(Model.StatusFilter == "bestseller" ? "active" : "")">
                <input type="radio" name="statusFilter" value="bestseller" id="statusBest@(prefix)" @(Model.StatusFilter == "bestseller" ? "checked" : "") onchange="this.form.submit()" />
                <label for="statusBest@(prefix)"><i class="ph-fill ph-fire text-warning"></i> Bán chạy</label>
            </div>
            <div class="filter-chip @(Model.StatusFilter == "new" ? "active" : "")">
                <input type="radio" name="statusFilter" value="new" id="statusNew@(prefix)" @(Model.StatusFilter == "new" ? "checked" : "") onchange="this.form.submit()" />
                <label for="statusNew@(prefix)"><i class="ph-fill ph-sparkle text-info"></i> Hàng mới</label>
            </div>
        </div>
    </div>

    <!-- 6. Đánh giá khách hàng -->
    <div class="filter-section">
        <div class="filter-section-title d-flex align-items-center justify-content-between">
            <span><i class="ph-fill ph-star text-warning"></i> Đánh giá</span>
            @if (Model.RatingFilter.HasValue)
            {
                <span class="badge bg-teal text-white rounded-pill" style="font-size: 0.7rem;">1 đã chọn</span>
            }
        </div>
        <div class="filter-options">
            <div class="filter-chip @(Model.RatingFilter == null ? "active" : "")">
                <input type="radio" name="ratingFilter" value="" id="ratingAll@(prefix)" @(Model.RatingFilter == null ? "checked" : "") onchange="this.form.submit()" />
                <label for="ratingAll@(prefix)">Tất cả</label>
            </div>
            <div class="filter-chip @(Model.RatingFilter == 4 ? "active" : "")">
                <input type="radio" name="ratingFilter" value="4" id="rating4@(prefix)" @(Model.RatingFilter == 4 ? "checked" : "") onchange="this.form.submit()" />
                <label for="rating4@(prefix)">
                    <span class="text-warning">★★★★</span>☆ trở lên
                </label>
            </div>
            <div class="filter-chip @(Model.RatingFilter == 3 ? "active" : "")">
                <input type="radio" name="ratingFilter" value="3" id="rating3@(prefix)" @(Model.RatingFilter == 3 ? "checked" : "") onchange="this.form.submit()" />
                <label for="rating3@(prefix)">
                    <span class="text-warning">★★★</span>☆☆ trở lên
                </label>
            </div>
        </div>
    </div>

    <!-- Buttons (chỉ hiện trên mobile) -->
    <div class="d-lg-none mt-4 d-flex flex-column gap-2">
        <button type="submit" class="btn w-100" style="background: var(--teal); color: #fff; border-radius: 999px; font-weight: 600; padding: 0.7rem 1.5rem;">
            <i class="ph ph-funnel me-1"></i> Áp dụng bộ lọc
        </button>
        <a asp-action="Index" class="btn w-100" style="border: 1.5px solid #e2e8f0; color: #64748b; border-radius: 999px; font-weight: 600; padding: 0.7rem 1.5rem;">
            <i class="ph ph-arrow-counter-clockwise me-1"></i> Xóa tất cả bộ lọc
        </a>
    </div>
</form>
