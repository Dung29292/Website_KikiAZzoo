@model PetProfile
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm hồ sơ thú cưng" : "Cập nhật hồ sơ thú cưng";
}

<div class="container py-4 profile-page">
    <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
            <div class="checkout-card p-4 rounded-4 shadow-sm border bg-white">
                <h3 class="fw-bold mb-4 text-dark"><i class="bi bi-paw text-teal"></i> @(Model.Id == 0 ? "Thêm thú cưng mới" : $"Cập nhật hồ sơ bé {Model.Name}")</h3>

                <form asp-action="Upsert" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="ImageUrl" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">Tên bé thú cưng <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="Nhập tên của bé..." required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Species" class="form-label">Loại thú cưng <span class="text-danger">*</span></label>
                            <select asp-for="Species" class="form-select" required>
                                <option value="Chó">Chó</option>
                                <option value="Mèo">Mèo</option>
                                <option value="Chim">Chim</option>
                                <option value="Hamster">Hamster</option>
                                <option value="Thỏ">Thỏ</option>
                                <option value="Khác">Khác</option>
                            </select>
                            <span asp-validation-for="Species" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Breed" class="form-label">Giống loài (Breed)</label>
                            <input asp-for="Breed" class="form-control" placeholder="VD: Poodle, Golden, Mèo Anh lông ngắn..." />
                            <span asp-validation-for="Breed" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Age" class="form-label">Tuổi của bé <span class="text-danger">*</span></label>
                            <input asp-for="Age" class="form-control" type="number" min="0" max="100" required />
                            <span asp-validation-for="Age" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Weight" class="form-label">Cân nặng (kg) <span class="text-danger">*</span></label>
                            <input asp-for="Weight" class="form-control" type="number" step="0.01" min="0.01" max="1000" required />
                            <span asp-validation-for="Weight" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Hình ảnh bé</label>
                            <div class="d-flex align-items-center gap-3">
                                <div class="pet-preview-box rounded-3 border bg-light d-flex align-items-center justify-content-center overflow-hidden shadow-sm" style="width: 100px; height: 100px;">
                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <img src="@Model.ImageUrl" id="petImagePreview" class="w-100 h-100 object-fit-cover" />
                                    }
                                    else
                                    {
                                        <div id="petImagePlaceholder" class="text-teal-light fs-2"><i class="bi bi-camera"></i></div>
                                        <img src="" id="petImagePreview" class="w-100 h-100 object-fit-cover d-none" />
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    <input type="file" name="imageFile" id="petImageFileInput" class="form-control" accept="image/*" />
                                    <small class="text-muted d-block mt-1">Chọn ảnh đại diện đáng yêu cho bé (JPG, PNG, WebP...)</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="HealthNotes" class="form-label">Ghi chú sức khỏe / Thói quen ăn uống</label>
                            <textarea asp-for="HealthNotes" class="form-control" rows="3" placeholder="VD: Đã tiêm phòng 2 mũi, dị ứng hạt gà, thích ăn pate cá..."></textarea>
                            <span asp-validation-for="HealthNotes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-teal rounded-pill px-4">
                            <i class="bi bi-save"></i> Lưu hồ sơ
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const fileInput = document.getElementById("petImageFileInput");
            const previewImg = document.getElementById("petImagePreview");
            const placeholder = document.getElementById("petImagePlaceholder");

            if (fileInput) {
                fileInput.addEventListener("change", function () {
                    const file = this.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            previewImg.src = e.target.result;
                            previewImg.classList.remove("d-none");
                            if (placeholder) placeholder.classList.add("d-none");
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
        });
    </script>
}
