@model IEnumerable<dynamic>
@* Password toggle partial - use with ViewData *@
@{
    var fieldId = ViewData["FieldId"]?.ToString() ?? "password";
    var fieldName = ViewData["FieldName"]?.ToString() ?? "Password";
    var placeholder = ViewData["Placeholder"]?.ToString() ?? "";
    var iconClass = ViewData["IconClass"]?.ToString() ?? "auth-input-group";
    var value = ViewData["Value"]?.ToString() ?? "";
}

<div class="input-group @iconClass">
    <span class="input-group-text"><i class="bi bi-lock"></i></span>
    <input type="password" name="@fieldName" id="@fieldId" class="form-control password-field" placeholder="@placeholder" value="@value" autocomplete="@(fieldName.Contains("Confirm") ? "new-password" : "current-password")" />
    <button type="button" class="input-group-text btn-toggle-password" onclick="togglePassword('@fieldId', this)" title="Hiện/ẩn mật khẩu">
        <i class="bi bi-eye"></i>
    </button>
</div>
