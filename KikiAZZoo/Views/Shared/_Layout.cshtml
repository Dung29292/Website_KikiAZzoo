@using KikiAZZoo.Extensions
@using KikiAZZoo.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@{
    var userId = UserManager.GetUserId(User);
    var cartKey = !string.IsNullOrEmpty(userId) ? $"Cart_{userId}" : "Cart_Guest";
    int cartCount = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        var sessionCart = Context.Session.GetObjectFromJson<ShoppingCart>(cartKey);
        if (sessionCart != null)
        {
            cartCount = sessionCart.TotalItems;
        }
        else if (!string.IsNullOrEmpty(userId))
        {
            try
            {
                cartCount = DbContext.UserCartItems.Where(c => c.UserId == userId).Sum(c => (int?)c.Quantity) ?? 0;
            }
            catch { }
        }
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KikiAzoo</title>
    <partial name="_Styles" />
</head>
<body>
    <script>
        window.isUserAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
        (function () {
            const localTheme = localStorage.getItem('kikiDarkMode');
            if (localTheme === '1' || (localTheme === null && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.body.classList.add('dark-mode');
            }
        })();
    </script>
    @{
        var curCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var curAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        bool isHome = curCtrl == "Home" && curAct == "Index";
        bool isPetShop = curCtrl == "PetShop";
        bool isProduct = curCtrl == "Product";
        bool isService = curCtrl == "Service";
        bool isNews = curCtrl == "News";
        bool isAbout = curCtrl == "Home" && curAct == "About";
        bool isContact = curCtrl == "Home" && curAct == "Contact";
    }
    <header class="site-header">
        <nav class="navbar navbar-expand-lg py-2 p-0">
            <div class="header-container container-xxl px-2 px-md-3 px-xl-4">
                <!-- Brand Logo -->
                <a class="navbar-brand-kiki d-flex align-items-center flex-shrink-0 me-2 me-xl-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/images/kikiazoo-removebg.png" alt="KikiAzoo" class="site-logo-img" />
                </a>

                <!-- Mobile Header Right Actions (Visible < 992px) -->
                <div class="d-flex d-lg-none align-items-center gap-2 ms-auto me-2">
                    <button class="header-icon-btn border-0 bg-transparent p-1" title="Chuyển giao diện" onclick="toggleDarkMode()">
                        <i class="ph ph-moon mobile-dark-icon" id="darkModeIconMobile"></i>
                    </button>
                    <a href="javascript:void(0)" onclick="openMiniCart()" class="header-icon-btn header-cart p-1" title="Giỏ hàng">
                        <i class="ph ph-shopping-cart"></i>
                        <span class="cart-badge @(cartCount > 0 ? "" : "d-none")">@cartCount</span>
                    </a>
                </div>

                <!-- Mobile Toggle Button -->
                <button class="navbar-toggler border-0 shadow-none px-2 py-1" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Collapsible Navbar Content -->
                <div class="collapse navbar-collapse" id="mainNav">
                    <!-- Mobile Search Bar (Visible only inside collapsed menu on mobile) -->
                    <div class="d-lg-none py-2 px-1 mb-2">
                        <form class="mobile-search-box position-relative" asp-area="" asp-controller="Product" asp-action="Index" method="get">
                            <input type="text" id="mobileSearchInput" name="search" class="form-control mobile-search-input" placeholder="Tìm thú cưng, thức ăn, phụ kiện..." autocomplete="off" />
                            <button type="submit" class="mobile-search-btn" aria-label="Search"><i class="ph ph-magnifying-glass"></i></button>
                            <div id="mobileSearchSuggestions" class="search-suggestions-box d-none"></div>
                        </form>
                    </div>

                    <!-- Main Navigation Links (Center, Evenly Distributed, Anti-wrap) -->
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 align-items-lg-center header-nav-list">
                        <li class="nav-item">
                            <a class="nav-link nav-link-kiki @(isHome ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="ph ph-house"></i>
                                <span>Trang chủ</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-kiki @(isPetShop ? "active" : "")" asp-area="" asp-controller="PetShop" asp-action="Index">
                                <i class="ph-fill ph-paw-print"></i>
                                <span>Thú cưng</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-kiki @(isProduct ? "active" : "")" asp-area="" asp-controller="Product" asp-action="Index">
                                <i class="ph ph-storefront"></i>
                                <span>Sản phẩm</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-kiki @(isService ? "active" : "")" asp-area="" asp-controller="Service" asp-action="Index">
                                <i class="ph ph-scissors"></i>
                                <span>Dịch vụ</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-kiki @(isNews ? "active" : "")" asp-area="" asp-controller="News" asp-action="Index">
                                <i class="ph ph-newspaper"></i>
                                <span>Tin tức</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-kiki @(isAbout ? "active" : "")" asp-area="" asp-controller="Home" asp-action="About">
                                <i class="ph ph-info"></i>
                                <span>Về chúng tôi</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-kiki @(isContact ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Contact">
                                <i class="ph ph-chat-circle-dots"></i>
                                <span>Liên hệ</span>
                            </a>
                        </li>
                    </ul>

                    <!-- Right Action Zone (Desktop) -->
                    <div class="header-right-zone d-flex align-items-center gap-1 gap-xl-2 ms-lg-auto flex-shrink-0">
                        <!-- Desktop Header Search Bar -->
                        <form class="d-none d-lg-flex header-search-box position-relative" asp-area="" asp-controller="Product" asp-action="Index" method="get">
                            <input type="text" id="headerSearchInput" name="search" class="form-control header-search-input" placeholder="Tìm kiếm..." autocomplete="off" />
                            <button type="submit" class="header-search-btn" aria-label="Search"><i class="ph ph-magnifying-glass"></i></button>
                            <div id="searchSuggestions" class="search-suggestions-box d-none"></div>
                        </form>

                        <!-- Dark Mode Toggle (Desktop) -->
                        <button id="darkModeToggle" class="header-icon-btn d-none d-lg-inline-flex border-0 bg-transparent" title="Chuyển giao diện sáng/tối" onclick="toggleDarkMode()">
                            <i class="ph ph-moon" id="darkModeIcon"></i>
                        </button>

                        <!-- Account / Auth Dropdown or Buttons -->
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="dropdown header-auth-zone">
                                <button type="button" class="header-icon-btn dropdown-toggle border-0 bg-transparent d-flex align-items-center gap-1" data-bs-toggle="dropdown" aria-expanded="false" title="Tài khoản">
                                    <i class="ph-fill ph-user-circle-check fs-5"></i>
                                    <span class="d-none d-xxl-inline small fw-semibold text-truncate" style="max-width: 90px;">@User.Identity?.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2 mt-2">
                                    <li>
                                        <div class="px-3 py-2 border-bottom mb-1">
                                            <div class="small text-muted">Đăng nhập bởi</div>
                                            <div class="fw-bold text-teal text-truncate">@User.Identity?.Name</div>
                                        </div>
                                    </li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-area="" asp-controller="Account" asp-action="Profile"><i class="ph ph-user me-2 text-teal"></i>Tài khoản cá nhân</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-area="" asp-controller="Account" asp-action="Orders"><i class="ph ph-shopping-bag me-2 text-orange"></i>Lịch sử đơn hàng</a></li>
                                    @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item rounded-3 py-2 text-primary fw-semibold" asp-area="Admin" asp-controller="Home" asp-action="Index"><i class="ph ph-gear me-2"></i>Trang Quản trị</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item rounded-3 py-2 text-danger fw-semibold" asp-area="" asp-controller="Account" asp-action="Logout"><i class="ph ph-sign-out me-2"></i>Đăng xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="header-auth-buttons d-flex align-items-center gap-1 gap-xl-2">
                                <a asp-area="" asp-controller="Account" asp-action="Login" class="btn-header-login">Đăng nhập</a>
                                <a asp-area="" asp-controller="Account" asp-action="Register" class="btn-header-register">Đăng ký</a>
                            </div>
                        }

                        <!-- Cart Button (Desktop) -->
                        <a href="javascript:void(0)" onclick="openMiniCart()" class="header-icon-btn header-cart d-none d-lg-inline-flex" title="Giỏ hàng">
                            <i class="ph ph-shopping-cart fs-5"></i>
                            <span class="cart-badge @(cartCount > 0 ? "" : "d-none")">@cartCount</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>@RenderBody()</main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="footer-brand"><img src="/images/kikiazoo-removebg.png" alt="KikiAzoo" style="width: 180px; height: 50px; object-fit: cover;" /></h5>
                    <p class="text-white-50 small">Cửa hàng thú cưng trực tuyến – bán thú cưng, phụ kiện, thức ăn và cung cấp dịch vụ spa, tắm rửa, nhận nuôi uy tín tại Việt Nam.</p>
                    <p class="text-white-50 small mb-1"><i class="ph ph-map-pin"></i> 123 Đường Pet, Q.1, TP.HCM</p>
                    <p class="text-white-50 small mb-1"><i class="ph ph-phone"></i> Hotline: 1900 1234</p>
                    <div class="footer-social mt-3">
                        <a href="#" title="Facebook"><i class="ph-fill ph-facebook-logo"></i></a>
                        <a href="#" title="Instagram"><i class="ph-fill ph-instagram-logo"></i></a>
                        <a href="#" title="TikTok"><i class="ph-fill ph-tiktok-logo"></i></a>
                        <a href="#" title="Youtube"><i class="ph-fill ph-youtube-logo"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>Cửa hàng</h5>
                    <a asp-area="" asp-controller="PetShop" asp-action="Index"><span class="badge bg-warning text-dark me-1" style="font-size: 0.65rem;">HOT</span>Thú cưng &amp; Cá cảnh</a>
                    <a asp-area="" asp-controller="Product" asp-action="Index" asp-route-categoryGroupId="2">Thức ăn</a>
                    <a asp-area="" asp-controller="Product" asp-action="Index" asp-route-categoryGroupId="3">Đồ chơi</a>
                    <a asp-area="" asp-controller="Product" asp-action="Index" asp-route-categoryGroupId="4">Phụ kiện</a>
                    <a asp-area="" asp-controller="Product" asp-action="Index" asp-route-categoryGroupId="5">Quần áo &amp; Chăm sóc</a>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>Dịch vụ</h5>
                    <a asp-area="" asp-controller="Service" asp-action="Index">Spa &amp; Chăm sóc</a>
                    <a asp-area="" asp-controller="Service" asp-action="Index">Tắm rửa</a>
                    <a asp-area="" asp-controller="Service" asp-action="Index">Nhận nuôi</a>
                    <a asp-area="" asp-controller="Service" asp-action="Index">Khách sạn pet</a>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>Hỗ trợ</h5>
                    <a asp-area="" asp-controller="Home" asp-action="FAQ">Câu hỏi thường gặp</a>
                    <a asp-area="" asp-controller="Home" asp-action="ShoppingGuide">Hướng dẫn mua hàng</a>
                    <a asp-area="" asp-controller="Home" asp-action="ReturnPolicy">Chính sách đổi trả</a>
                    <a asp-area="" asp-controller="Home" asp-action="ShippingPolicy">Vận chuyển</a>
                    <a asp-area="" asp-controller="Home" asp-action="Contact">Liên hệ</a>
                </div>
            </div>
            <hr class="border-secondary mt-4" />
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <p class="text-white-50 small mb-0">&copy; 2026 KikiAzoo. All rights reserved.</p>
                <div class="d-flex gap-3">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="footer-link-inline">Bảo mật</a>
                    <a asp-area="" asp-controller="Home" asp-action="About" class="footer-link-inline">Giới thiệu</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Add to Cart Modal -->
    <div class="modal fade" id="addToCartModal" tabindex="-1" aria-labelledby="addToCartLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border: none; border-radius: 16px;">
                <div class="modal-header" style="border-bottom: 1px solid #eee; padding: 1.5rem;">
                    <h5 class="modal-title fw-bold" id="addToCartLabel" style="color: var(--dark);">Thêm vào giỏ hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="padding: 2rem;">
                    <div class="row g-3">
                        <div class="col-4">
                            <img id="modalProductImage" src="" alt="Product" style="width: 100%; border-radius: 12px; object-fit: cover;">
                        </div>
                        <div class="col-8">
                            <h6 id="modalProductName" class="fw-bold" style="color: var(--dark); margin-bottom: 0.5rem;"></h6>
                            <p id="modalProductCategory" style="font-size: 0.85rem; color: #999; margin-bottom: 1rem;"></p>
                            <div style="background: #f8f9fa; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                    <span style="font-size: 0.9rem; color: #666;">Đơn giá:</span>
                                    <span id="modalProductPrice" class="fw-bold" style="color: var(--teal); font-size: 1rem;"></span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #e0e0e0;">
                                    <span style="font-size: 0.9rem; color: #666;">Số lượng:</span>
                                    <div class="quantity-selector" style="display: flex; align-items: center; gap: 0.5rem;">
                                        <button class="qty-btn" id="decreaseQty" style="width: 32px; height: 32px; border: 1px solid #ddd; border-radius: 6px; background: #fff; cursor: pointer; font-weight: bold; color: #666;">−</button>
                                        <input type="number" id="modalQuantity" value="1" min="1" style="width: 60px; text-align: center; border: 1px solid #ddd; border-radius: 6px; padding: 0.4rem;">
                                        <button class="qty-btn" id="increaseQty" style="width: 32px; height: 32px; border: 1px solid #ddd; border-radius: 6px; background: #fff; cursor: pointer; font-weight: bold; color: #666;">+</button>
                                    </div>
                                </div>
                            </div>
                            <div style="background: rgba(94, 180, 159, 0.08); padding: 1rem; border-radius: 8px; text-align: center;">
                                <span style="font-size: 0.85rem; color: #666;">Tổng cộng:</span>
                                <div id="modalTotalPrice" style="font-size: 1.5rem; font-weight: 800; color: var(--teal); margin-top: 0.25rem;"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid #eee; padding: 1.5rem; gap: 1rem;">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" style="border-radius: 8px; padding: 0.6rem 2rem;">Hủy</button>
                    <button type="button" id="confirmAddToCart" class="btn btn-teal" style="border-radius: 8px; padding: 0.6rem 2rem;">Thêm vào giỏ</button>
                    <button type="button" id="confirmBuyNow" class="btn btn-orange d-none" style="border-radius: 8px; padding: 0.6rem 2rem;">Mua ngay</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Mini Cart Drawer -->
    <div id="miniCartDrawer" class="mini-cart-drawer">
        <div id="miniCartContainer">
            <!-- Loaded dynamically via AJAX -->
        </div>
    </div>
    <div id="miniCartOverlay" class="mini-cart-overlay" onclick="closeMiniCart()"></div>

    <partial name="_Scripts" />
    <script src="~/js/toast.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function updateDarkModeIcons(isDark) {
            const icon = document.getElementById('darkModeIcon');
            const iconMobile = document.getElementById('darkModeIconMobile');
            if (icon) icon.className = isDark ? 'ph ph-sun text-warning' : 'ph ph-moon';
            if (iconMobile) iconMobile.className = isDark ? 'ph ph-sun text-warning mobile-dark-icon' : 'ph ph-moon mobile-dark-icon';
        }

        function toggleDarkMode() {
            document.body.classList.toggle('dark-mode');
            const isDark = document.body.classList.contains('dark-mode');
            localStorage.setItem('kikiDarkMode', isDark ? '1' : '0');
            updateDarkModeIcons(isDark);
        }

        document.addEventListener("DOMContentLoaded", function () {
            const isDark = document.body.classList.contains('dark-mode');
            updateDarkModeIcons(isDark);

            // Listen for system theme changes dynamically
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
                if (localStorage.getItem('kikiDarkMode') === null) {
                    const shouldBeDark = e.matches;
                    if (shouldBeDark) {
                        document.body.classList.add('dark-mode');
                    } else {
                        document.body.classList.remove('dark-mode');
                    }
                    updateDarkModeIcons(shouldBeDark);
                }
            });
        });
    </script>
</body>
</html>
