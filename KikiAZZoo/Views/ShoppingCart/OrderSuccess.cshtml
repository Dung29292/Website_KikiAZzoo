@model int
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container py-5">
    <div class="order-success-card text-center mx-auto">
        <div class="order-success-icon">
            <i class="bi bi-check-lg"></i>
        </div>
        <h2 class="fw-bold mt-4">Đặt hàng thành công!</h2>
        <p class="text-muted mb-1">Cảm ơn bạn đã tin tưởng mua sắm tại KikiAzoo.</p>
        <p class="order-success-id">Mã đơn hàng: <strong>#@Model</strong></p>

        <div class="order-success-steps">
            <div class="order-success-step active">
                <span class="step-dot"><i class="bi bi-check"></i></span>
                <span>Đặt hàng</span>
            </div>
            <div class="order-success-step-line"></div>
            <div class="order-success-step">
                <span class="step-dot">2</span>
                <span>Xác nhận</span>
            </div>
            <div class="order-success-step-line"></div>
            <div class="order-success-step">
                <span class="step-dot">3</span>
                <span>Giao hàng</span>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
            <a asp-controller="Account" asp-action="OrderDetails" asp-route-id="@Model" class="btn btn-teal">
                <i class="bi bi-bag"></i> Xem đơn hàng
            </a>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-bag-heart"></i> Tiếp tục mua sắm
            </a>
        </div>
    </div>
</div>
