@model IEnumerable<Service>
@{
    ViewData["Title"] = "Dịch vụ";
}

<div class="container py-5">
    <nav class="breadcrumb-kiki mb-4">
        <a asp-controller="Home" asp-action="Index">Trang chủ</a> > Dịch vụ
    </nav>

    <!-- Hero Showcase Banner -->
    <div class="service-hero-banner p-4 p-md-5 mb-5 rounded-4 position-relative overflow-hidden shadow-sm" 
         style="background: linear-gradient(135deg, #0d9488 0%, #134e4a 100%); color: #fff;">
        <div class="position-absolute end-0 bottom-0 opacity-25 pe-none d-none d-lg-block" style="transform: translate(10%, 20%); font-size: 16rem; line-height: 1;">
            <i class="ph ph-scissors"></i>
        </div>
        <div class="row align-items-center position-relative">
            <div class="col-lg-8">
                <span class="badge rounded-pill px-3 py-2 mb-3 fw-bold" style="background: rgba(255,255,255,0.2); backdrop-filter: blur(8px); color: #fff;">
                    ✂️ DỊCH VỤ CHĂM SÓC TOÀN DIỆN KIKIAZOO
                </span>
                <h1 class="display-6 fw-bold mb-3">Spa, Cắt Tỉa & Khách Sạn Thú Cưng Đẳng Cấp</h1>
                <p class="lead mb-0 text-white-50" style="max-width: 650px; font-size: 0.98rem; line-height: 1.6;">
                    Trải nghiệm dịch vụ chăm sóc thú cưng chuẩn quốc tế với đội ngũ chuyên viên tận tâm, thiết bị tiệt trùng hiện đại và các gói spa, lưu trú cao cấp dành riêng cho boss yêu của bạn.
                </p>
                <div class="mt-3 small text-white-50">
                    <span class="badge bg-white text-teal rounded-pill px-3 py-1 fw-bold me-2">@(Model?.Count() ?? 0) dịch vụ cao cấp</span>
                    <span class="badge rounded-pill px-2 py-1" style="background: rgba(255,255,255,0.2);"><i class="ph ph-clock me-1"></i>Mở cửa 8:00 - 21:00 hàng ngày</span>
                </div>
            </div>
            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                <div class="d-inline-flex flex-column gap-2 text-start p-3 rounded-4" style="background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.15);">
                    <div class="d-flex align-items-center gap-2 small text-white">
                        <i class="ph-fill ph-certificate text-warning fs-5"></i>
                        <span>Chuyên viên chứng chỉ quốc tế</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 small text-white">
                        <i class="ph-fill ph-sparkle text-info fs-5"></i>
                        <span>Khử khuẩn tia UV tiệt trùng 100%</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 small text-white">
                        <i class="ph-fill ph-calendar-check text-success fs-5"></i>
                        <span>Đặt lịch online & giữ chỗ ưu tiên</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @{
            int idx = 0;
            var iconColors = new[] {
                "linear-gradient(135deg, var(--teal), var(--teal-dark))",
                "linear-gradient(135deg, var(--orange), var(--orange-dark))",
                "linear-gradient(135deg, #8b5cf6, #7c3aed)",
                "linear-gradient(135deg, var(--pink), #db2777)",
                "linear-gradient(135deg, #38bdf8, #0284c7)",
                "linear-gradient(135deg, #fbbf24, #d97706)"
            };
        }
        @foreach (var s in Model ?? Enumerable.Empty<Service>())
        {
            var color = iconColors[idx % iconColors.Length];
            idx++;
            <div class="col-md-6 col-lg-4">
                <div class="service-card-full h-100">
                    <div class="service-icon-wrap" style="background: @color">
                        <i class="bi @s.Icon"></i>
                    </div>
                    <h5 class="fw-bold">@s.Name</h5>
                    <p class="text-muted small mb-0">@s.Description</p>

                    @if (s.PriceFrom.HasValue)
                    {
                        <div class="service-price-tag mt-3">
                            <i class="ph ph-money me-1"></i>
                            @(s.PriceFrom == 0 ? "Miễn phí tư vấn" : $"Từ {s.PriceFrom.Value.ToString("#,##0")}đ")
                        </div>
                    }

                    <div class="service-card-actions mt-auto pt-3">
                        <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-teal btn-sm">
                            <i class="ph ph-eye me-1"></i>Chi tiết
                        </a>
                        <a asp-controller="ServiceBooking" asp-action="Book" asp-route-serviceId="@s.Id" class="btn btn-outline-teal btn-sm">
                            <i class="ph ph-calendar-check me-1"></i>Đặt lịch
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
